<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="comprehensure.AppShell"
    x:Name="AppShellRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dashboard="clr-namespace:comprehensure.DASHBOARD"
    xmlns:local="clr-namespace:comprehensure"
    xmlns:models="clr-namespace:comprehensure.Models"
    Shell.FlyoutBehavior="Flyout"
    FlyoutBackgroundColor="#F2F6FB">

    <!-- ══════════════════════════════════════════════════ -->
    <!--  FLYOUT HEADER                                     -->
    <!-- ══════════════════════════════════════════════════ -->
    <Shell.FlyoutHeader>
        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F2D4A" Offset="0" />
                    <GradientStop Color="#1B4A72" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Ellipse Fill="White" WidthRequest="260" HeightRequest="200"
                     HorizontalOptions="End" VerticalOptions="Start"
                     Margin="0,-60,-80,0" Opacity="0.05" />
            <Ellipse Fill="#D6EAFF" WidthRequest="180" HeightRequest="160"
                     HorizontalOptions="Start" VerticalOptions="End"
                     Margin="-60,0,0,-50" Opacity="0.10" />
            <VerticalStackLayout Padding="24,36,24,28" Spacing="16">
                <HorizontalStackLayout Spacing="14" VerticalOptions="Center">
                    <Border HeightRequest="60" WidthRequest="60"
                            BackgroundColor="#1B4A72" Stroke="#CBDCEB" StrokeThickness="2">
                        <Border.StrokeShape><RoundRectangle CornerRadius="30" /></Border.StrokeShape>
                        <Border.Shadow><Shadow Brush="#000000" Offset="0,4" Radius="14" Opacity="0.20" /></Border.Shadow>
                        <Image Source="user.png" Aspect="AspectFill" />
                    </Border>
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label Text="WELCOME BACK," TextColor="#80c2ed" FontAttributes="Bold" FontSize="9" CharacterSpacing="2.0" />
                        <Label Text="ComprehenSure" TextColor="White" FontAttributes="Bold" FontSize="20" CharacterSpacing="0.5" />
                        <Label Text="Learning Dashboard" TextColor="#80c2ed" FontSize="11" CharacterSpacing="1.2" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
                <BoxView HeightRequest="1" BackgroundColor="#FFFFFF" Opacity="0.12" />
                <Label Text="NAVIGATION" TextColor="#80c2ed" FontAttributes="Bold" FontSize="9" CharacterSpacing="2.4" />
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <!-- ══════════════════════════════════════════════════ -->
    <!--  FLYOUT ITEMS                                      -->
    <!-- ══════════════════════════════════════════════════ -->
    <FlyoutItem Title="Settings" Icon="settings.png">
        <Shell.ItemTemplate>
            <DataTemplate>
                <Border Margin="14,5" Padding="18,16" BackgroundColor="White" Stroke="#CBDCEB" StrokeThickness="1">
                    <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="#0F2D4A" Offset="0,4" Radius="12" Opacity="0.07" /></Border.Shadow>
                    <HorizontalStackLayout Spacing="16" VerticalOptions="Center">
                        <Border HeightRequest="42" WidthRequest="42" BackgroundColor="#D6EAFF" Stroke="#CBDCEB" StrokeThickness="1">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <Image Source="{Binding Icon}" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                            <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15" TextColor="#0F2D4A" />
                            <Label Text="Account &amp; settings" FontSize="11" TextColor="#6B8CAE" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>
            </DataTemplate>
        </Shell.ItemTemplate>
        <ShellContent ContentTemplate="{DataTemplate dashboard:ProfileDashboard}" Route="ProfileDashboard" />
    </FlyoutItem>

    <FlyoutItem Title="Dashboard" Icon="home.png">
        <Shell.ItemTemplate>
            <DataTemplate>
                <Border Margin="14,5" Padding="18,16" BackgroundColor="White" Stroke="#CBDCEB" StrokeThickness="1">
                    <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="#0F2D4A" Offset="0,4" Radius="12" Opacity="0.07" /></Border.Shadow>
                    <HorizontalStackLayout Spacing="16" VerticalOptions="Center">
                        <Border HeightRequest="42" WidthRequest="42" BackgroundColor="#D6EAFF" Stroke="#CBDCEB" StrokeThickness="1">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <Image Source="{Binding Icon}" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                            <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15" TextColor="#0F2D4A" />
                            <Label Text="Home overview" FontSize="11" TextColor="#6B8CAE" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>
            </DataTemplate>
        </Shell.ItemTemplate>
        <ShellContent ContentTemplate="{DataTemplate dashboard:MainDashboard}" Route="MainDashboard" />
    </FlyoutItem>

    <FlyoutItem Title="Modules" Icon="book.png">
        <Shell.ItemTemplate>
            <DataTemplate>
                <Border Margin="14,5" Padding="18,16" BackgroundColor="White" Stroke="#CBDCEB" StrokeThickness="1">
                    <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="#0F2D4A" Offset="0,4" Radius="12" Opacity="0.07" /></Border.Shadow>
                    <HorizontalStackLayout Spacing="16" VerticalOptions="Center">
                        <Border HeightRequest="42" WidthRequest="42" BackgroundColor="#D6EAFF" Stroke="#CBDCEB" StrokeThickness="1">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <Image Source="{Binding Icon}" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                            <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15" TextColor="#0F2D4A" />
                            <Label Text="Browse all lessons" FontSize="11" TextColor="#6B8CAE" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>
            </DataTemplate>
        </Shell.ItemTemplate>
        <ShellContent ContentTemplate="{DataTemplate dashboard:ModulesDashboard}" Route="ModuleDashboard" />
    </FlyoutItem>

    <FlyoutItem Title="Mini Games" Icon="game.png">
        <Shell.ItemTemplate>
            <DataTemplate>
                <Border Margin="14,5" Padding="18,16" BackgroundColor="White" Stroke="#CBDCEB" StrokeThickness="1">
                    <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="#0F2D4A" Offset="0,4" Radius="12" Opacity="0.07" /></Border.Shadow>
                    <HorizontalStackLayout Spacing="16" VerticalOptions="Center">
                        <Border HeightRequest="42" WidthRequest="42" BackgroundColor="#D6EAFF" Stroke="#CBDCEB" StrokeThickness="1">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <Image Source="{Binding Icon}" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                            <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15" TextColor="#0F2D4A" />
                            <Label Text="Play &amp; practice" FontSize="11" TextColor="#6B8CAE" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>
            </DataTemplate>
        </Shell.ItemTemplate>
        <ShellContent ContentTemplate="{DataTemplate dashboard:ModulesDashboard}" Route="MiniGames" />
    </FlyoutItem>

    <!-- ══════════════════════════════════════════════════ -->
    <!--  FLYOUT FOOTER — Log Out                          -->
    <!-- ══════════════════════════════════════════════════ -->
    <Shell.FlyoutFooter>
        <VerticalStackLayout Padding="14,0,14,32" Spacing="0">
            <BoxView HeightRequest="1" BackgroundColor="#CBDCEB" Margin="4,0,4,14" />
            <Border BackgroundColor="#0F2D4A" Stroke="Transparent" StrokeThickness="0">
                <Border.StrokeShape><RoundRectangle CornerRadius="26" /></Border.StrokeShape>
                <Border.Shadow><Shadow Brush="#0F2D4A" Offset="0,5" Radius="14" Opacity="0.22" /></Border.Shadow>
                <Button Text="Log Out"
                        Clicked="OnLogOutClicked"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        BorderWidth="0"
                        HeightRequest="52"
                        FontAttributes="Bold"
                        FontSize="14"
                        CharacterSpacing="0.8" />
            </Border>
        </VerticalStackLayout>
    </Shell.FlyoutFooter>

    <!-- ══════════════════════════════════════════════════ -->
    <!--  HIDDEN SHELL CONTENTS                            -->
    <!-- ══════════════════════════════════════════════════ -->
    <ShellContent Title="Login"    ContentTemplate="{DataTemplate local:LoginPage}"       Route="Login"       FlyoutItemIsVisible="False" />
    <ShellContent Title="SignUp"   ContentTemplate="{DataTemplate local:SignUpPage}"      Route="signUp"      FlyoutItemIsVisible="False" />
    <ShellContent Title="Username" ContentTemplate="{DataTemplate dashboard:UsernameReq}" Route="UsernameReq" FlyoutItemIsVisible="False" />
    <ShellContent Title="MainPage" ContentTemplate="{DataTemplate local:MainPage}"        Route="MainPage"    FlyoutItemIsVisible="False" />

</Shell>
