<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="comprehensure.DASHBOARD.ProfileDashboard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F2F6FB"
    Shell.NavBarIsVisible="False">

    <Grid>

        <!-- Background decorative blobs — matches MainDashboard exactly -->
        <Grid HorizontalOptions="Fill" VerticalOptions="Fill" InputTransparent="True">
            <Ellipse
                Fill="White"
                WidthRequest="580" HeightRequest="440"
                HorizontalOptions="Start" VerticalOptions="Start"
                Margin="-140,-110,0,0" Opacity="0.75" />
            <Ellipse
                Fill="#D6EAFF"
                WidthRequest="460" HeightRequest="380"
                HorizontalOptions="End" VerticalOptions="End"
                Margin="0,0,-110,-60" Opacity="0.45" />
        </Grid>

        <ScrollView>
            <VerticalStackLayout Padding="36,28,36,48" Spacing="18">

                <!-- ══════════════════════════════════════════ -->
                <!-- PROFILE SECTION                          -->
                <!-- ══════════════════════════════════════════ -->
                <HorizontalStackLayout Margin="4,0" Spacing="10">
                    <BoxView
                        BackgroundColor="#0F2D4A"
                        CornerRadius="2"
                        HeightRequest="20"
                        VerticalOptions="Center"
                        WidthRequest="4" />
                    <Label
                        CharacterSpacing="2.2"
                        FontAttributes="Bold"
                        FontSize="12"
                        Text="PROFILE"
                        TextColor="#0F2D4A"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Border
                    Padding="24,20"
                    BackgroundColor="White"
                    Stroke="#CBDCEB"
                    StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#0F2D4A" Offset="0,4" Radius="16" Opacity="0.06" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">

                        <!-- Avatar + Name row -->
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="16">
                            <Border
                                Grid.Column="0"
                                BackgroundColor="#D6EAFF"
                                HeightRequest="72" WidthRequest="72"
                                Stroke="#CBDCEB"
                                StrokeThickness="2">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="36" />
                                </Border.StrokeShape>
                                <Image Source="user.png" Aspect="AspectFill" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    Text="{Binding UsernameEdit}"
                                    TextColor="#0F2D4A" />
                                <Label
                                    FontSize="13"
                                    Text="{Binding UserEmail}"
                                    TextColor="#6B8CAE" />
                            </VerticalStackLayout>

                            <!-- Edit Profile button -->
                            <Border
                                Grid.Column="2"
                                BackgroundColor="Transparent"
                                Stroke="#CBDCEB"
                                StrokeThickness="1"
                                VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20" />
                                </Border.StrokeShape>
                                <Button
                                    BackgroundColor="Transparent"
                                    BorderWidth="0"
                                    CharacterSpacing="1.0"
                                    Command="{Binding EditProfileCommand}"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    HeightRequest="40"
                                    Padding="16,0"
                                    Text="Edit"
                                    TextColor="#0F2D4A" />
                            </Border>
                        </Grid>

                        <BoxView BackgroundColor="#CBDCEB" HeightRequest="1" />

                        <!-- Username field -->
                        <VerticalStackLayout Spacing="6">
                            <Label
                                CharacterSpacing="1.5"
                                FontAttributes="Bold"
                                FontSize="10"
                                Text="USERNAME"
                                TextColor="#6B8CAE" />
                            <Border
                                BackgroundColor="#F2F6FB"
                                Stroke="#CBDCEB"
                                StrokeThickness="1"
                                Padding="14,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Entry
                                    HeightRequest="48"
                                    Placeholder="Enter username"
                                    PlaceholderColor="#CBDCEB"
                                    Text="{Binding UsernameEdit}"
                                    TextColor="#0F2D4A"
                                    BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>
                        
                        <!-- Save Changes button -->
                        <Border
                            BackgroundColor="#0F2D4A"
                            Stroke="Transparent"
                            StrokeThickness="0"
                            Margin="0,4,0,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="26" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#0F2D4A" Offset="0,5" Radius="14" Opacity="0.22" />
                            </Border.Shadow>
                            <Button
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                CharacterSpacing="1.2"
                                Command="{Binding SaveProfileCommand}"
                                FontAttributes="Bold"
                                FontSize="13"
                                HeightRequest="52"
                                Text="✓  Save Changes"
                                TextColor="White" />
                        </Border>

                    </VerticalStackLayout>
                </Border>
                
                <!-- ══════════════════════════════════════════ -->
                <!-- ══════════════════════════════════════════ -->
                <!-- ACCOUNT SECTION                          -->
                <!-- ══════════════════════════════════════════ -->
                <HorizontalStackLayout Margin="4,8,4,0" Spacing="10">
                    <BoxView
                        BackgroundColor="#0F2D4A"
                        CornerRadius="2"
                        HeightRequest="20"
                        VerticalOptions="Center"
                        WidthRequest="4" />
                    <Label
                        CharacterSpacing="2.2"
                        FontAttributes="Bold"
                        FontSize="12"
                        Text="ACCOUNT"
                        TextColor="#0F2D4A"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Border
                    Padding="24,8"
                    BackgroundColor="White"
                    Stroke="#CBDCEB"
                    StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#0F2D4A" Offset="0,4" Radius="16" Opacity="0.06" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="0">

                        <!-- Help & Support -->
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="16" Padding="0,14">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding HelpCommand}" />
                            </Grid.GestureRecognizers>
                            <Border
                                Grid.Column="0"
                                BackgroundColor="#D6EAFF"
                                HeightRequest="44" WidthRequest="44"
                                Stroke="Transparent" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                                <Label Text="💬" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" FontAttributes="Bold" FontSize="15"
                                Text="Help &amp; Support"
                                TextColor="#0F2D4A"
                                VerticalOptions="Center" />
                            <Label Grid.Column="2" FontSize="18"
                                Text="›"
                                TextColor="#CBDCEB"
                                VerticalOptions="Center" />
                        </Grid>

                        <BoxView BackgroundColor="#F2F6FB" HeightRequest="1" />

                        <!-- App Version -->
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="16" Padding="0,14">
                            <Border
                                Grid.Column="0"
                                BackgroundColor="#D6EAFF"
                                HeightRequest="44" WidthRequest="44"
                                Stroke="Transparent" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                                <Label Text="ℹ️" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" FontAttributes="Bold" FontSize="15"
                                Text="App Version"
                                TextColor="#0F2D4A"
                                VerticalOptions="Center" />
                            <Label Grid.Column="2" FontSize="13"
                                Text="v1.0.0"
                                TextColor="#6B8CAE"
                                VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- ══════════════════════════════════════════ -->
                <!-- LOGOUT BUTTON — pinned at bottom          -->
                <!-- ══════════════════════════════════════════ -->
                <Border
                    Margin="0,24,0,0"
                    BackgroundColor="Transparent"
                    Stroke="#E53935"
                    StrokeThickness="1.5">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="26" />
                    </Border.StrokeShape>
                    <Button
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        CharacterSpacing="2.0"
                        Clicked="OnLogoutClicked"
                        FontAttributes="Bold"
                        FontSize="14"
                        HeightRequest="56"
                        Text="⏻  LOGOUT"
                        TextColor="#E53935" />
                </Border>

                <!-- Bottom spacer -->
                <BoxView HeightRequest="8" Color="Transparent" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- ══════════════════════════════════════════ -->
        <!-- LOGOUT CONFIRMATION POPUP                 -->
        <!-- ══════════════════════════════════════════ -->
        <Grid x:Name="LogoutPopupOverlay"
              IsVisible="False"
              BackgroundColor="#60000000"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">

            <Border HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="400"
                    BackgroundColor="White"
                    Stroke="#CBDCEB"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="36" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#0F2D4A" Offset="0,16" Radius="48" Opacity="0.15" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="0">

                    <!-- Top gradient accent band -->
                    <Border HeightRequest="6" Stroke="Transparent" StrokeThickness="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#0F2D4A" Offset="0" />
                                <GradientStop Color="#4A7FA8" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="36,36,0,0" />
                        </Border.StrokeShape>
                    </Border>

                    <VerticalStackLayout Spacing="20" Padding="36,28,36,32">

                        <!-- Icon chip -->
                        <Border BackgroundColor="#D6EAFF"
                                Stroke="Transparent" StrokeThickness="0"
                                HeightRequest="64" WidthRequest="64"
                                HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="32" />
                            </Border.StrokeShape>
                            <Label Text="🚪"
                                   FontSize="30"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <!-- Title -->
                        <Label Text="Log Out?"
                               FontSize="22" FontAttributes="Bold"
                               TextColor="#0F2D4A"
                               HorizontalOptions="Center" />

                        <!-- Body message -->
                        <Label Text="Are you sure you want to log out of your account?"
                               FontSize="14" TextColor="#6B8CAE"
                               HorizontalTextAlignment="Center"
                               LineHeight="1.6"
                               LineBreakMode="WordWrap" />

                        <!-- Divider -->
                        <BoxView HeightRequest="1" BackgroundColor="#D6EAFF" Margin="0,4" />

                        <!-- Action buttons -->
                        <VerticalStackLayout Spacing="12">

                            <Border BackgroundColor="#0F2D4A"
                                    Stroke="Transparent" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="26" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#0F2D4A" Offset="0,6" Radius="16" Opacity="0.22" />
                                </Border.Shadow>
                                <Button Text="Yes, log out"
                                        Clicked="OnLogoutConfirm"
                                        BackgroundColor="Transparent"
                                        TextColor="White"
                                        BorderWidth="0"
                                        FontAttributes="Bold" FontSize="14"
                                        HeightRequest="52" />
                            </Border>

                            <Border BackgroundColor="Transparent"
                                    Stroke="#CBDCEB" StrokeThickness="1.5">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="26" />
                                </Border.StrokeShape>
                                <Button Text="Cancel"
                                        Clicked="OnLogoutCancel"
                                        BackgroundColor="Transparent"
                                        TextColor="#0F2D4A"
                                        BorderWidth="0"
                                        FontAttributes="Bold" FontSize="14"
                                        HeightRequest="52" />
                            </Border>

                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
