<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="comprehensure.DASHBOARD.ChangePassword"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F2F6FB"
    Shell.NavBarIsVisible="False">

    <Grid>

        <!-- Background decorative blobs — matches ProfileDashboard -->
        <Grid HorizontalOptions="Fill" VerticalOptions="Fill" InputTransparent="True">
            <Ellipse
                Fill="White"
                WidthRequest="580" HeightRequest="440"
                HorizontalOptions="Start" VerticalOptions="Start"
                Margin="-140,-110,0,0" Opacity="0.75" />
            <Ellipse
                Fill="#D6EAFF"
                WidthRequest="460" HeightRequest="380"
                HorizontalOptions="End" VerticalOptions="End"
                Margin="0,0,-110,-60" Opacity="0.45" />
        </Grid>

        <ScrollView>
            <VerticalStackLayout Padding="36,28,36,48" Spacing="18">

                <!-- ══════════════════════════════════════════ -->
                <!-- HEADER                                    -->
                <!-- ══════════════════════════════════════════ -->
                <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,8">

                    <!-- Back button -->
                    <Border Grid.Column="0"
                            BackgroundColor="White" Stroke="#CBDCEB" StrokeThickness="1"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#0F2D4A" Offset="0,4" Radius="12" Opacity="0.07" />
                        </Border.Shadow>
                        <Button Text="← Back"
                                Command="{Binding GoBackCommand}"
                                BackgroundColor="Transparent"
                                TextColor="#0F2D4A"
                                BorderWidth="0"
                                FontAttributes="Bold"
                                FontSize="13"
                                HeightRequest="44"
                                Padding="20,0" />
                    </Border>
                    <!-- Title -->
                    <Label
                        Grid.Column="1"
                        FontAttributes="Bold"
                        FontSize="30"
                        HorizontalOptions="Center"
                        Text="CHANGE PASSWORD"
                        TextColor="#0F2D4A"
                        VerticalOptions="Center" />

                </Grid>

                <!-- ══════════════════════════════════════════ -->
                <!-- SECTION LABEL                            -->
                <!-- ══════════════════════════════════════════ -->
                <HorizontalStackLayout Margin="4,0" Spacing="10">
                    <BoxView
                        BackgroundColor="#0F2D4A"
                        CornerRadius="2"
                        HeightRequest="20"
                        VerticalOptions="Center"
                        WidthRequest="4" />
                    <Label
                        CharacterSpacing="2.2"
                        FontAttributes="Bold"
                        FontSize="12"
                        Text="SECURITY"
                        TextColor="#0F2D4A"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!-- ══════════════════════════════════════════ -->
                <!-- FORM CARD                                 -->
                <!-- ══════════════════════════════════════════ -->
                <Border
                    Padding="24,20"
                    BackgroundColor="White"
                    Stroke="#CBDCEB"
                    StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#0F2D4A" Offset="0,4" Radius="16" Opacity="0.06" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">

                        <!-- Lock icon + description -->
                        <HorizontalStackLayout Spacing="12" Margin="0,0,0,4">
                            <Border
                                BackgroundColor="#D6EAFF"
                                HeightRequest="48" WidthRequest="48"
                                Stroke="Transparent" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="24" />
                                </Border.StrokeShape>
                                <Label Text="🔒" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="15"
                                    Text="Update your password"
                                    TextColor="#0F2D4A" />
                                <Label
                                    FontSize="12"
                                    Text="Enter your current password to confirm."
                                    TextColor="#6B8CAE" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <BoxView BackgroundColor="#CBDCEB" HeightRequest="1" />

                        <!-- Current Password -->
                        <VerticalStackLayout Spacing="6">
                            <Label
                                CharacterSpacing="1.5"
                                FontAttributes="Bold"
                                FontSize="10"
                                Text="CURRENT PASSWORD"
                                TextColor="#6B8CAE" />
                            <Border
                                BackgroundColor="#F2F6FB"
                                Stroke="#CBDCEB"
                                StrokeThickness="1"
                                Padding="14,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Entry
                                    HeightRequest="48"
                                    IsPassword="True"
                                    Placeholder="Enter current password"
                                    PlaceholderColor="#CBDCEB"
                                    Text="{Binding CurrentPassword}"
                                    TextColor="#0F2D4A"
                                    BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- New Password -->
                        <VerticalStackLayout Spacing="6">
                            <Label
                                CharacterSpacing="1.5"
                                FontAttributes="Bold"
                                FontSize="10"
                                Text="NEW PASSWORD"
                                TextColor="#6B8CAE" />
                            <Border
                                BackgroundColor="#F2F6FB"
                                Stroke="#CBDCEB"
                                StrokeThickness="1"
                                Padding="14,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Entry
                                    HeightRequest="48"
                                    IsPassword="True"
                                    Placeholder="Enter new password"
                                    PlaceholderColor="#CBDCEB"
                                    Text="{Binding NewPassword}"
                                    TextColor="#0F2D4A"
                                    BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Confirm New Password -->
                        <VerticalStackLayout Spacing="6">
                            <Label
                                CharacterSpacing="1.5"
                                FontAttributes="Bold"
                                FontSize="10"
                                Text="CONFIRM NEW PASSWORD"
                                TextColor="#6B8CAE" />
                            <Border
                                BackgroundColor="#F2F6FB"
                                Stroke="#CBDCEB"
                                StrokeThickness="1"
                                Padding="14,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Entry
                                    HeightRequest="48"
                                    IsPassword="True"
                                    Placeholder="Confirm new password"
                                    PlaceholderColor="#CBDCEB"
                                    Text="{Binding ConfirmPassword}"
                                    TextColor="#0F2D4A"
                                    BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Error message -->
                        <Border
                            IsVisible="{Binding HasError}"
                            BackgroundColor="#FFF0F0"
                            Stroke="#FFCDD2"
                            StrokeThickness="1"
                            Padding="14,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="⚠️" FontSize="14" VerticalOptions="Center" />
                                <Label
                                    Text="{Binding ErrorMessage}"
                                    TextColor="#C62828"
                                    FontSize="13"
                                    VerticalOptions="Center"
                                    LineBreakMode="WordWrap" />
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Save button -->
                        <Border
                            BackgroundColor="#0F2D4A"
                            Stroke="Transparent"
                            StrokeThickness="0"
                            Margin="0,4,0,0"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="26" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#0F2D4A" Offset="0,5" Radius="14" Opacity="0.22" />
                            </Border.Shadow>
                            <Button
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                CharacterSpacing="1.2"
                                Command="{Binding ChangePasswordCommand}"
                                FontAttributes="Bold"
                                FontSize="13"
                                HeightRequest="52"
                                Text="{Binding IsBusy, Converter={StaticResource BusyTextConverter}, ConverterParameter='✓  Update Password|Updating...'}"
                                TextColor="White" />
                        </Border>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading overlay -->
        <Grid
            IsVisible="{Binding IsBusy}"
            BackgroundColor="#40000000"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            InputTransparent="False">
            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                Color="#4A90D9"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="48"
                HeightRequest="48" />
        </Grid>

    </Grid>
</ContentPage>
