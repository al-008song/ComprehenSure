<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="comprehensure.DASHBOARD.StoryPage.QuizPage7"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F2F6FB"
    Shell.NavBarIsVisible="False">

    <Grid>

        <Grid
            HorizontalOptions="Fill"
            InputTransparent="True"
            VerticalOptions="Fill">
            <Ellipse
                Margin="-140,-110,0,0"
                Fill="White"
                HeightRequest="440"
                HorizontalOptions="Start"
                Opacity="0.75"
                VerticalOptions="Start"
                WidthRequest="580" />
            <Ellipse
                Margin="0,0,-110,-60"
                Fill="#D6EAFF"
                HeightRequest="380"
                HorizontalOptions="End"
                Opacity="0.45"
                VerticalOptions="End"
                WidthRequest="460" />
        </Grid>

        <Grid
            RowDefinitions="Auto, Auto, Auto, Auto, Auto"
            Padding="40,14,40,16"
            HorizontalOptions="Center"
            MaximumWidthRequest="720"
            RowSpacing="8">

            <Grid
                    Grid.Row="0"
                    ColumnDefinitions="Auto, *, Auto"
                    ColumnSpacing="14">

                <Border
                        Grid.Column="0"
                        BackgroundColor="White"
                        Stroke="#CBDCEB"
                        StrokeThickness="1"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow
                                Brush="#0F2D4A"
                                Opacity="0.07"
                                Radius="12"
                                Offset="0,4" />
                    </Border.Shadow>
                    <Button
                            Padding="20,0"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            Clicked="OnBackClicked"
                            FontAttributes="Bold"
                            FontSize="13"
                            HeightRequest="44"
                            Text="← Back"
                            TextColor="#0F2D4A" />
                </Border>

                <VerticalStackLayout
                        Grid.Column="1"
                        HorizontalOptions="Center"
                        Spacing="2"
                        VerticalOptions="Center">
                    <Label
                            CharacterSpacing="2.2"
                            FontAttributes="Bold"
                            FontSize="10"
                            HorizontalOptions="Center"
                            Text="MODULE 7"
                            TextColor="#2E6BA8" />
                    <Label
                            FontAttributes="Bold"
                            FontSize="20"
                            HorizontalOptions="Center"
                            Text="The City of Silent Bargains Quiz"
                            TextColor="#0F2D4A" />
                </VerticalStackLayout>

                <Border Grid.Column="2"
                            Padding="14,8" BackgroundColor="#FBE9E7"
                            Stroke="#FFAB91" StrokeThickness="1"
                            VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Label Text="Intermediate" FontSize="12"
                               FontAttributes="Bold" TextColor="#BF360C" />
                </Border>


            </Grid>

            <VerticalStackLayout Grid.Row="1" Spacing="6">
                <Grid ColumnDefinitions="*, Auto">
                    <Label
                            x:Name="QuestionNumberLabel"
                            Grid.Column="0"
                            FontAttributes="Bold"
                            FontSize="12"
                            Text="{Binding QuestionNumber}"
                            TextColor="#6B8CAE" />
                    <Label
                            x:Name="ProgressPercent"
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontSize="12"
                            Text="0%"
                            TextColor="#2E6BA8" />
                </Grid>

                <Border
                        BackgroundColor="#E2EAF4"
                        HeightRequest="8"
                        Stroke="Transparent"
                        StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="4" />
                    </Border.StrokeShape>
                    <Border
                            x:Name="ProgressFill"
                            BackgroundColor="#0F2D4A"
                            HeightRequest="8"
                            HorizontalOptions="Start"
                            Stroke="Transparent"
                            StrokeThickness="0"
                            WidthRequest="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="4" />
                        </Border.StrokeShape>
                    </Border>
                </Border>
            </VerticalStackLayout>

            <Border
                    x:Name="QuestionCard"
                    Grid.Row="2"
                    Padding="32,24"
                    HeightRequest="170"
                    BackgroundColor="White"
                    Stroke="#CBDCEB"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow
                            Brush="#0F2D4A"
                            Opacity="0.07"
                            Radius="32"
                            Offset="0,10" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label
                            Margin="0,-10,0,-18"
                            FontSize="48"
                            HorizontalOptions="Start"
                            Opacity="0.18"
                            Text="&#x201C;"
                            TextColor="#2E6BA8" />
                    <Label
                            x:Name="QuestionText"
                            FontSize="15"
                            HorizontalTextAlignment="Start"
                            LineHeight="1.75"
                            Text="{Binding Mainquestion}"
                            TextColor="#1A2E42"
                            VerticalOptions="Start" />
                    <Label
                            Margin="0,-18,0,-10"
                            FontSize="48"
                            HorizontalOptions="End"
                            Opacity="0.18"
                            Text="&#x201D;"
                            TextColor="#2E6BA8" />
                </VerticalStackLayout>
            </Border>

            <ScrollView Grid.Row="3" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout x:Name="OptionsContainer" Spacing="10" Padding="0,4,0,4">

                    <Border
                            x:Name="BorderA"
                            Padding="20,14"
                            BackgroundColor="White"
                            Stroke="#CBDCEB"
                            StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="26" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#0F2D4A" Opacity="0.05" Radius="12" Offset="0,4" />
                        </Border.Shadow>
                        <Grid ColumnDefinitions="34,*" ColumnSpacing="16">
                            <Border
                                    x:Name="CircleA"
                                    Grid.Column="0"
                                    BackgroundColor="Transparent"
                                    HeightRequest="34" WidthRequest="34"
                                    Stroke="#CBDCEB" StrokeThickness="1.5"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="17" />
                                </Border.StrokeShape>
                                <Label FontAttributes="Bold" FontSize="13" HorizontalOptions="Center" Text="A" TextColor="#2E6BA8" VerticalOptions="Center" />
                            </Border>
                            <Label x:Name="BtnA" Grid.Column="1" FontSize="15" LineBreakMode="WordWrap" Text="{Binding Ch1bt}" TextColor="#1A2E42" VerticalOptions="Center" />
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer CommandParameter="A" Tapped="OnOptionClicked" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Border
                            x:Name="BorderB"
                            Padding="20,14"
                            BackgroundColor="White"
                            Stroke="#CBDCEB"
                            StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="26" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#0F2D4A" Opacity="0.05" Radius="12" Offset="0,4" />
                        </Border.Shadow>
                        <Grid ColumnDefinitions="34,*" ColumnSpacing="16">
                            <Border
                                    x:Name="CircleB"
                                    Grid.Column="0"
                                    BackgroundColor="Transparent"
                                    HeightRequest="34" WidthRequest="34"
                                    Stroke="#CBDCEB" StrokeThickness="1.5"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="17" />
                                </Border.StrokeShape>
                                <Label FontAttributes="Bold" FontSize="13" HorizontalOptions="Center" Text="B" TextColor="#2E6BA8" VerticalOptions="Center" />
                            </Border>
                            <Label x:Name="BtnB" Grid.Column="1" FontSize="15" LineBreakMode="WordWrap" Text="{Binding Ch2bt}" TextColor="#1A2E42" VerticalOptions="Center" />
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer CommandParameter="B" Tapped="OnOptionClicked" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Border
                            x:Name="BorderC"
                            Padding="20,14"
                            BackgroundColor="White"
                            Stroke="#CBDCEB"
                            StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="26" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#0F2D4A" Opacity="0.05" Radius="12" Offset="0,4" />
                        </Border.Shadow>
                        <Grid ColumnDefinitions="34,*" ColumnSpacing="16">
                            <Border
                                    x:Name="CircleC"
                                    Grid.Column="0"
                                    BackgroundColor="Transparent"
                                    HeightRequest="34" WidthRequest="34"
                                    Stroke="#CBDCEB" StrokeThickness="1.5"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="17" />
                                </Border.StrokeShape>
                                <Label FontAttributes="Bold" FontSize="13" HorizontalOptions="Center" Text="C" TextColor="#2E6BA8" VerticalOptions="Center" />
                            </Border>
                            <Label x:Name="BtnC" Grid.Column="1" FontSize="15" LineBreakMode="WordWrap" Text="{Binding Ch3bt}" TextColor="#1A2E42" VerticalOptions="Center" />
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer CommandParameter="C" Tapped="OnOptionClicked" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Border
                            x:Name="BorderD"
                            Padding="20,14"
                            BackgroundColor="White"
                            Stroke="#CBDCEB"
                            StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="26" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#0F2D4A" Opacity="0.05" Radius="12" Offset="0,4" />
                        </Border.Shadow>
                        <Grid ColumnDefinitions="34,*" ColumnSpacing="16">
                            <Border
                                    x:Name="CircleD"
                                    Grid.Column="0"
                                    BackgroundColor="Transparent"
                                    HeightRequest="34" WidthRequest="34"
                                    Stroke="#CBDCEB" StrokeThickness="1.5"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="17" />
                                </Border.StrokeShape>
                                <Label FontAttributes="Bold" FontSize="13" HorizontalOptions="Center" Text="D" TextColor="#2E6BA8" VerticalOptions="Center" />
                            </Border>
                            <Label x:Name="BtnD" Grid.Column="1" FontSize="15" LineBreakMode="WordWrap" Text="{Binding Ch4bt}" TextColor="#1A2E42" VerticalOptions="Center" />
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer CommandParameter="D" Tapped="OnOptionClicked" />
                        </Border.GestureRecognizers>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

            <Grid x:Name="NextButtonRow" Grid.Row="4" ColumnDefinitions="*, Auto" ColumnSpacing="16" Margin="0,4,0,8">
                <Border
                        Grid.Column="1"
                        BackgroundColor="#0F2D4A"
                        Stroke="Transparent"
                        StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="26" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#0F2D4A" Opacity="0.22" Radius="16" Offset="0,6" />
                    </Border.Shadow>
                    <Button
                            x:Name="NextButton"
                            Padding="22,0"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            Clicked="OnNextClicked"
                            FontAttributes="Bold"
                            FontSize="13"
                            HeightRequest="44"
                            IsEnabled="False"
                            Text="Next  ▶"
                            TextColor="White" />
                </Border>
            </Grid>

            <Border
                    x:Name="CompleteBanner"
                    Grid.Row="2"
                    Grid.RowSpan="3"
                    IsVisible="False"
                    BackgroundColor="White"
                    Stroke="#CBDCEB"
                    StrokeThickness="1"
                    VerticalOptions="Fill">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="36" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#0F2D4A" Opacity="0.10" Radius="32" Offset="0,10" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="0">

                    <Border HeightRequest="6" Stroke="Transparent" StrokeThickness="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="#0F2D4A" />
                                <GradientStop Offset="1" Color="#2E6BA8" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="36,36,0,0" />
                        </Border.StrokeShape>
                    </Border>

                    <VerticalStackLayout Spacing="24" Padding="40,36,40,40">

                        <Border
                                BackgroundColor="#FFF8DC"
                                Stroke="#E8C547"
                                StrokeThickness="1.5"
                                HeightRequest="80" WidthRequest="80"
                                HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="40" />
                            </Border.StrokeShape>
                            <Label Text="🏆" FontSize="38" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label Text="Quiz Complete!" FontSize="26" FontAttributes="Bold" TextColor="#0F2D4A" HorizontalOptions="Center" />
                            <Label Text="Here's how you did" FontSize="14" TextColor="#6B8CAE" HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <Border
                                BackgroundColor="#EBF4FF"
                                Stroke="#CBDCEB"
                                StrokeThickness="1"
                                Padding="0,28"
                                HorizontalOptions="Fill">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="28" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label x:Name="FinalScoreLabel" Text="0 / 0" FontSize="52" FontAttributes="Bold" TextColor="#0F2D4A" HorizontalOptions="Center" />
                                <Label Text="correct answers" FontSize="13" TextColor="#6B8CAE" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <Label
                                x:Name="ScoreMessageLabel"
                                Text=""
                                FontSize="14"
                                TextColor="#6B8CAE"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                LineHeight="1.6" />

                        <BoxView HeightRequest="1" BackgroundColor="#E2EAF4" />

                        <Border
                                BackgroundColor="#0F2D4A"
                                Stroke="Transparent"
                                StrokeThickness="0"
                                HorizontalOptions="Fill">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="26" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#0F2D4A" Opacity="0.22" Radius="16" Offset="0,6" />
                            </Border.Shadow>
                            <Button
                                    Padding="22,0"
                                    BackgroundColor="Transparent"
                                    BorderWidth="0"
                                    Clicked="OnFinishClicked"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    HeightRequest="52"
                                    Text="FINISH  →"
                                    TextColor="White" />
                        </Border>

                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </Grid>


        <Grid
            x:Name="PopupOverlay"
            BackgroundColor="#80000000"
            HorizontalOptions="Fill"
            IsVisible="False"
            VerticalOptions="Fill">

            <Border
                BackgroundColor="White"
                HorizontalOptions="Center"
                Stroke="#CBDCEB"
                StrokeThickness="1"
                VerticalOptions="Center"
                WidthRequest="400">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="36" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow
                        Brush="#0F2D4A"
                        Opacity="0.18"
                        Radius="48"
                        Offset="0,16" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="0">

                    <Border
                        HeightRequest="6"
                        Stroke="Transparent"
                        StrokeThickness="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="#0F2D4A" />
                                <GradientStop Offset="1" Color="#2E6BA8" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="36,36,0,0" />
                        </Border.StrokeShape>
                    </Border>

                    <VerticalStackLayout Padding="36,28,36,32" Spacing="20">


                        <Label
                            FontAttributes="Bold"
                            FontSize="22"
                            HorizontalOptions="Center"
                            Text="Leave Quiz?"
                            TextColor="#0F2D4A" />


                        <Label
                            FontSize="14"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="WordWrap"
                            LineHeight="1.6"
                            Text="Your quiz progress won't be saved. Are you sure you want to go back?"
                            TextColor="#6B8CAE" />


                        <BoxView
                            Margin="0,4"
                            BackgroundColor="#EBF4FF"
                            HeightRequest="1" />


                        <VerticalStackLayout Spacing="12">

                            <Border
                                BackgroundColor="#0F2D4A"
                                Stroke="Transparent"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="26" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow
                                        Brush="#0F2D4A"
                                        Opacity="0.22"
                                        Radius="16"
                                        Offset="0,6" />
                                </Border.Shadow>
                                <Button
                                    BackgroundColor="Transparent"
                                    BorderWidth="0"
                                    Clicked="OnPopupConfirm"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    HeightRequest="52"
                                    Text="Yes, leave quiz"
                                    TextColor="White" />
                            </Border>

                            <Border
                                BackgroundColor="Transparent"
                                Stroke="#CBDCEB"
                                StrokeThickness="1.5">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="26" />
                                </Border.StrokeShape>
                                <Button
                                    BackgroundColor="Transparent"
                                    BorderWidth="0"
                                    Clicked="OnPopupCancel"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    HeightRequest="52"
                                    Text="Keep answering"
                                    TextColor="#0F2D4A" />
                            </Border>

                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
