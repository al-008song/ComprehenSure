<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="comprehensure.DASHBOARD.StoryPage.DictionaryPage2"
             BackgroundColor="#0A0F1E"
             Shell.NavBarIsVisible="False">


    <Grid>

        <Grid InputTransparent="True" HorizontalOptions="Fill" VerticalOptions="Fill">
            <Ellipse Fill="#1A2744" WidthRequest="500" HeightRequest="500"
                     HorizontalOptions="Start" VerticalOptions="Start"
                     Margin="-180,-180,0,0" Opacity="0.6"/>
            <Ellipse Fill="#0F1A30" WidthRequest="400" HeightRequest="400"
                     HorizontalOptions="End" VerticalOptions="End"
                     Margin="0,0,-120,-120" Opacity="0.5"/>
            <Ellipse Fill="#1E2F52" WidthRequest="300" HeightRequest="300"
                     HorizontalOptions="Center" VerticalOptions="Center"
                     Opacity="0.3"/>
        </Grid>

        <ScrollView>
            <VerticalStackLayout Spacing="0" Padding="0,0,0,60"
                                 HorizontalOptions="Center"
                                 MaximumWidthRequest="760">

                <Grid Padding="32,52,32,32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            BackgroundColor="#0F1A30" Stroke="#1E3A6B" StrokeThickness="1"
                            HorizontalOptions="Start" Margin="0,0,0,28">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Button Text="← Back to Story"
                                x:Name="BackBtn"
                                Clicked="OnBackClicked"
                                BackgroundColor="Transparent"
                                TextColor="#7EB8F7"
                                BorderWidth="0"
                                FontAttributes="Bold"
                                FontSize="13"
                                HeightRequest="44"
                                Padding="20,0"/>
                    </Border>


                    <HorizontalStackLayout Grid.Row="1" Spacing="14"
                                           HorizontalOptions="Center"
                                           Margin="0,0,0,16">

                        <BoxView BackgroundColor="#1E3A6B" HeightRequest="1" WidthRequest="60"
                                 VerticalOptions="Center"/>
                        <Label Text="📖" FontSize="36" VerticalOptions="Center"/>
                        <BoxView BackgroundColor="#1E3A6B" HeightRequest="1" WidthRequest="60"
                                 VerticalOptions="Center"/>
                    </HorizontalStackLayout>


                    <VerticalStackLayout Grid.Row="2" Spacing="6" HorizontalOptions="Center">
                        <Label Text="VOCABULARY"
                               FontSize="11" FontAttributes="Bold"
                               TextColor="#4A90D9" CharacterSpacing="5"
                               HorizontalOptions="Center"/>
                        <Label Text="The Clockmaker's Secret"
                               FontSize="28" FontAttributes="Bold"
                               TextColor="#E8F0FF"
                               HorizontalOptions="Center"/>
                        <Label Text="17 words to know"
                               FontSize="13" TextColor="#4A6A9A"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Grid>

                <Border HeightRequest="1" Stroke="Transparent" Margin="32,0,32,32">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="#1E3A6B" Offset="0.5"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>



                <Border Margin="24,0,24,8"
                        BackgroundColor="#0D1528"
                        Stroke="#1E3A6B" StrokeThickness="1.5">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,0" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="🔍" FontSize="16" VerticalOptions="Center" TextColor="#4A6A9A"/>
                        <Entry x:Name="SearchEntry"
                               Grid.Column="1"
                               Placeholder="Search words..."
                               PlaceholderColor="#4A6A9A"
                               TextColor="#E8F0FF"
                               BackgroundColor="Transparent"
                               FontSize="14"
                               HeightRequest="46"
                               TextChanged="OnSearchTextChanged"/>
                        <Button x:Name="ClearSearchBtn"
                                Grid.Column="2"
                                Text="✕"
                                FontSize="13"
                                TextColor="#4A6A9A"
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                HeightRequest="36"
                                WidthRequest="36"
                                Padding="0"
                                IsVisible="False"
                                Clicked="OnClearSearchClicked"/>
                    </Grid>
                </Border>

                <Label x:Name="NoResultsLabel"
                       Text="No words found."
                       FontSize="14"
                       TextColor="#4A6A9A"
                       HorizontalOptions="Center"
                       Margin="0,4,0,0"
                       IsVisible="False"/>

                <VerticalStackLayout x:Name="WordCardsContainer" Spacing="16" Padding="24,0">

                    <Border x:Name="CardNarrow" BackgroundColor="#0D1528" Stroke="#8B6914" StrokeThickness="1" Padding="0">
