<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="comprehensure.DASHBOARD.MainDashboard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F2F6FB"
    Shell.NavBarIsVisible="False">

    <Grid>

        <!-- Background decorative blobs -->
        <Grid HorizontalOptions="Fill" VerticalOptions="Fill" InputTransparent="True">
            <Ellipse
                Fill="White"
                WidthRequest="400" HeightRequest="320"
                HorizontalOptions="Start" VerticalOptions="Start"
                Margin="-80,-80,0,0" Opacity="0.75" />
            <Ellipse
                Fill="#D6EAFF"
                WidthRequest="320" HeightRequest="280"
                HorizontalOptions="End" VerticalOptions="End"
                Margin="0,0,-80,-40" Opacity="0.45" />
        </Grid>

        <ScrollView>
            <VerticalStackLayout
                Padding="18,20,18,40"
                Spacing="16">

                <!-- ══════════════════════════════════════════ -->
                <!-- HEADER CARD                                -->
                <!-- ══════════════════════════════════════════ -->
                <Border
                    Padding="20,18"
                    BackgroundColor="White"
                    Stroke="#CBDCEB"
                    StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#0F2D4A" Offset="0,6" Radius="20" Opacity="0.07" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">

                        <!-- Top row: DASHBOARD label + Settings -->
                        <Grid ColumnDefinitions="*, Auto">
                            <Label
                                Grid.Column="0"
                                CharacterSpacing="2.5"
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="DASHBOARD"
                                TextColor="#0F2D4A"
                                VerticalOptions="Center" />
                            <Border
                                Grid.Column="1"
                                BackgroundColor="Transparent"
                                Stroke="Transparent"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <PointerGestureRecognizer
                                        PointerEntered="OnPointerEntered"
                                        PointerExited="OnPointerExited"
                                        PointerPressed="OnPointerPressed"
                                        PointerReleased="OnPointerReleased" />
                                </Border.GestureRecognizers>
                                <ImageButton
                                    Command="{Binding ProfileDashboardCommand}"
                                    HeightRequest="28"
                                    Opacity="0.45"
                                    Source="settings.png"
                                    VerticalOptions="Center"
                                    WidthRequest="28" />
                            </Border>
                        </Grid>

                        <!-- Bottom row: Avatar + Name + Progress ring -->
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14" VerticalOptions="Center">

                            <!-- Avatar -->
                            <Border
                                Grid.Column="0"
                                BackgroundColor="#D6EAFF"
                                HeightRequest="56"
                                Stroke="#CBDCEB"
                                StrokeThickness="2"
                                WidthRequest="56">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="28" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#0F2D4A" Offset="0,3" Radius="8" Opacity="0.08" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <PointerGestureRecognizer
                                        PointerEntered="OnPointerEntered"
                                        PointerExited="OnPointerExited"
                                        PointerPressed="OnPointerPressed"
                                        PointerReleased="OnPointerReleased" />
                                </Border.GestureRecognizers>
                                <ImageButton
                                    Aspect="AspectFill"
                                    Command="{Binding ProfileDashboardCommand}"
                                    Source="user.png" />
                            </Border>

                            <!-- Welcome + username -->
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label
                                    CharacterSpacing="2.0"
                                    FontAttributes="Bold"
                                    FontSize="11"
                                    Text="WELCOME BACK,"
                                    TextColor="#0F2D4A" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="22"
                                    Text="{Binding UsernameEdit}"
                                    TextColor="#0F2D4A"
                                    LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>

                            <!-- Progress ring + score -->
                            <Grid
                                Grid.Column="2"
                                ColumnDefinitions="Auto, Auto"
                                ColumnSpacing="12"
                                VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                                    <Label
                                        CharacterSpacing="1.2"
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        Text="{Binding ScoreDisplay}"
                                        TextColor="#0F2D4A" />
                                    <Label
                                        CharacterSpacing="1.4"
                                        FontAttributes="Bold"
                                        FontSize="8"
                                        Text="SCORE"
                                        TextColor="#6B8CAE" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                                    <Grid HeightRequest="90" WidthRequest="90">
                                        <Ellipse Fill="Transparent" Stroke="#D6EAFF" StrokeThickness="10" />
                                        <Ellipse
                                            x:Name="DashboardProgressCircle"
                                            Fill="Transparent"
                                            Rotation="-90"
                                            Stroke="#0F2D4A"
                                            StrokeDashArray="100,100"
                                            StrokeDashOffset="{Binding StrokeOffset}"
                                            StrokeThickness="10" />
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="19"
                                            HorizontalOptions="Center"
                                            Text="{Binding DisplayPercentage}"
                                            TextColor="#0F2D4A"
                                            VerticalOptions="Center" />
                                    </Grid>
                                    <Label
                                        CharacterSpacing="1.4"
                                        FontAttributes="Bold"
                                        FontSize="8"
                                        HorizontalOptions="Center"
                                        Text="PROGRESS"
                                        TextColor="#6B8CAE" />
                                </VerticalStackLayout>
                            </Grid>

                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- ══════════════════════════════════════════ -->
                <!-- MODULES BUTTON                             -->
                <!-- ══════════════════════════════════════════ -->
                <Border
                    BackgroundColor="#0F2D4A"
                    Stroke="Transparent"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#0F2D4A" Offset="0,10" Radius="28" Opacity="0.28" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <PointerGestureRecognizer
                            PointerEntered="OnPointerEntered"
                            PointerExited="OnPointerExited"
                            PointerPressed="OnPointerPressed"
                            PointerReleased="OnPointerReleased" />
                    </Border.GestureRecognizers>

                    <Grid RowDefinitions="Auto,Auto" RowSpacing="0">
                        <!-- "START LEARNING" pill badge -->
                        <Border
                            Grid.Row="0"
                            Margin="0,10,0,0"
                            Padding="12,4"
                            HorizontalOptions="Center"
                            Stroke="#EBBF0C"
                            StrokeThickness="1">
                            <Border.Background>
                                <SolidColorBrush Color="#EBBF0C" />
                            </Border.Background>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <Label
                                CharacterSpacing="2.5"
                                FontAttributes="Bold"
                                FontSize="9"
                                HorizontalOptions="Center"
                                Text="★  START LEARNING"
                                TextColor="#FFFFFF" />
                        </Border>
                        <Button
                            Grid.Row="1"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            CharacterSpacing="3.5"
                            Command="{Binding modulesCommand}"
                            FontAttributes="Bold"
                            FontSize="22"
                            HeightRequest="70"
                            Text="📚  MODULES"
                            TextColor="White" />
                    </Grid>
                </Border>

                <!-- ══════════════════════════════════════════ -->
                <!-- ABOUT US BUTTON                            -->
                <!-- ══════════════════════════════════════════ -->
                <Border
                    BackgroundColor="#0F2D4A"
                    Stroke="Transparent"
                    StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#0F2D4A" Offset="0,4" Radius="12" Opacity="0.07" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <PointerGestureRecognizer
                            PointerEntered="OnPointerEntered"
                            PointerExited="OnPointerExited"
                            PointerPressed="OnPointerPressed"
                            PointerReleased="OnPointerReleased" />
                    </Border.GestureRecognizers>
                    <Button
                        BackgroundColor="#0F2D4A"
                        BorderWidth="0"
                        CharacterSpacing="2.0"
                        Command="{Binding AboutUsCommand}"
                        FontAttributes="Bold"
                        FontSize="20"
                        HeightRequest="70"
                        Text="ABOUT US"
                        TextColor="White" />
                </Border>

                <!-- ══════════════════════════════════════════ -->
                <!-- MASTER DICTIONARY BUTTON                   -->
                <!-- ══════════════════════════════════════════ -->
                <Border
                    Margin="0,4,0,0"
                    Stroke="#1E3A6B"
                    StrokeThickness="1.5">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0A0F1E" Offset="0"/>
                            <GradientStop Color="#0F1A30" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#4A90D9" Offset="0,6" Radius="20" Opacity="0.18"/>
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <PointerGestureRecognizer
                            PointerEntered="OnPointerEntered"
                            PointerExited="OnPointerExited"
                            PointerPressed="OnPointerPressed"
                            PointerReleased="OnPointerReleased" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,14" ColumnSpacing="14">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMasterDictionaryClicked"/>
                        </Grid.GestureRecognizers>
                        <!-- Book icon chip -->
                        <Border Grid.Column="0"
                                BackgroundColor="#0F1A30"
                                Stroke="#1E3A6B" StrokeThickness="1"
                                HeightRequest="48" WidthRequest="48">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24"/>
                            </Border.StrokeShape>
                            <Label Text="📚" FontSize="22"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                        <!-- Text -->
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="MASTER DICTIONARY"
                                   FontSize="10" FontAttributes="Bold"
                                   TextColor="#4A90D9" CharacterSpacing="2.0"/>
                            <Label Text="All words from Modules 1–8"
                                   FontSize="12" TextColor="#4A6A9A"/>
                            <HorizontalStackLayout Spacing="6" Margin="0,4,0,0">
                                <Border BackgroundColor="#1B4A1B" Stroke="#2E7D32" StrokeThickness="1" Padding="7,3">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <Label Text="🟢 Easy" FontSize="10" FontAttributes="Bold" TextColor="#A5D6A7"/>
                                </Border>
                                <Border BackgroundColor="#3D3200" Stroke="#F9A825" StrokeThickness="1" Padding="7,3">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <Label Text="🟡 Average" FontSize="10" FontAttributes="Bold" TextColor="#FFE082"/>
                                </Border>
                                <Border BackgroundColor="#4A0F0F" Stroke="#C62828" StrokeThickness="1" Padding="7,3">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <Label Text="🔴 Intermediate" FontSize="10" FontAttributes="Bold" TextColor="#EF9A9A"/>
                                </Border>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- ══════════════════════════════════════════ -->
                <!-- CHALLENGE ZONE                             -->
                <!-- ══════════════════════════════════════════ -->

                <!-- Section heading -->
                <HorizontalStackLayout Margin="4,4,4,0" Spacing="10">
                    <BoxView
                        BackgroundColor="#0F2D4A"
                        CornerRadius="2"
                        HeightRequest="20"
                        VerticalOptions="Center"
                        WidthRequest="4" />
                    <Label
                        CharacterSpacing="2.2"
                        FontAttributes="Bold"
                        FontSize="13"
                        Text="CHALLENGE ZONE"
                        TextColor="#0F2D4A"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!-- Lock notice -->
                <Border
                    IsVisible="{Binding IsMinigameLocked}"
                    Padding="16,10"
                    BackgroundColor="#FFF3E0"
                    Stroke="#FFCC80"
                    StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Label
                        Text="🔒  Complete Module 3 to unlock Mini-Games"
                        FontSize="12"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        TextColor="#E65100"/>
                </Border>

                <!-- Challenge cards — side by side (2 columns, works on mobile width) -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="14">

                    <!-- SYNONYM HUNT card -->
                    <Border
                        Grid.Column="0"
                        Padding="0,0,0,20"
                        BackgroundColor="White"
                        Stroke="#CBDCEB"
                        StrokeThickness="1"
                        IsEnabled="{Binding IsMinigameUnlocked}"
                        Opacity="{Binding MinigameOpacity}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#0F2D4A" Offset="0,6" Radius="18" Opacity="0.07" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <PointerGestureRecognizer
                                PointerEntered="OnPointerEntered"
                                PointerExited="OnPointerExited"
                                PointerPressed="OnPointerPressed"
                                PointerReleased="OnPointerReleased" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="0">
                            <Border
                                HeightRequest="160"
                                Stroke="Transparent"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="24,24,0,0" />
                                </Border.StrokeShape>
                                <Image
                                    Aspect="AspectFill"
                                    Source="synonym_thumb.png"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill" />
                            </Border>
                            <VerticalStackLayout Margin="14,12,14,0" HorizontalOptions="Center" Spacing="8">
                                <Label
                                    CharacterSpacing="1.2"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    HorizontalOptions="Center"
                                    Text="SYNONYM HUNT"
                                    TextColor="#0F2D4A" />
                                <Label
                                    FontSize="11"
                                    HorizontalTextAlignment="Center"
                                    LineBreakMode="WordWrap"
                                    Text="Match words with the same meaning"
                                    TextColor="#6B8CAE" />
                                <Border
                                    BackgroundColor="#0F2D4A"
                                    Stroke="Transparent"
                                    StrokeThickness="0"
                                    Margin="0,4,0,0"
                                    IsEnabled="{Binding IsMinigameUnlocked}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="22" />
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="#0F2D4A" Offset="0,4" Radius="10" Opacity="0.22" />
                                    </Border.Shadow>
                                    <Border.GestureRecognizers>
                                        <PointerGestureRecognizer
                                            PointerEntered="OnPointerEntered"
                                            PointerExited="OnPointerExited"
                                            PointerPressed="OnPointerPressed"
                                            PointerReleased="OnPointerReleased" />
                                    </Border.GestureRecognizers>
                                    <Button
                                        BackgroundColor="Transparent"
                                        BorderWidth="0"
                                        CharacterSpacing="1.0"
                                        Clicked="OnSynonymHuntClicked"
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        HeightRequest="44"
                                        Text="PLAY"
                                        TextColor="White" />
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 4 PICS 1 THEME card -->
                    <Border
                        Grid.Column="1"
                        Padding="0,0,0,20"
                        BackgroundColor="White"
                        Stroke="#CBDCEB"
                        StrokeThickness="1"
                        IsEnabled="{Binding IsMinigameUnlocked}"
                        Opacity="{Binding MinigameOpacity}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#0F2D4A" Offset="0,6" Radius="18" Opacity="0.07" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <PointerGestureRecognizer
                                PointerEntered="OnPointerEntered"
                                PointerExited="OnPointerExited"
                                PointerPressed="OnPointerPressed"
                                PointerReleased="OnPointerReleased" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="0">
                            <Border
                                HeightRequest="160"
                                Stroke="Transparent"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="24,24,0,0" />
                                </Border.StrokeShape>
                                <Image
                                    Aspect="AspectFill"
                                    Source="theme_thumb.png"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill" />
                            </Border>
                            <VerticalStackLayout Margin="14,12,14,0" HorizontalOptions="Center" Spacing="8">
                                <Label
                                    CharacterSpacing="1.2"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    HorizontalOptions="Center"
                                    Text="4 PICS 1 THEME"
                                    TextColor="#0F2D4A" />
                                <Label
                                    FontSize="11"
                                    HorizontalTextAlignment="Center"
                                    LineBreakMode="WordWrap"
                                    Text="Guess the theme from four image clues"
                                    TextColor="#6B8CAE" />
                                <Border
                                    BackgroundColor="#0F2D4A"
                                    Stroke="Transparent"
                                    StrokeThickness="0"
                                    Margin="0,4,0,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="22" />
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="#0F2D4A" Offset="0,4" Radius="10" Opacity="0.22" />
                                    </Border.Shadow>
                                    <Border.GestureRecognizers>
                                        <PointerGestureRecognizer
                                            PointerEntered="OnPointerEntered"
                                            PointerExited="OnPointerExited"
                                            PointerPressed="OnPointerPressed"
                                            PointerReleased="OnPointerReleased" />
                                    </Border.GestureRecognizers>
                                    <Button
                                        BackgroundColor="Transparent"
                                        BorderWidth="0"
                                        CharacterSpacing="1.0"
                                        Clicked="OnOneWordClicked"
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        HeightRequest="44"
                                        Text="PLAY"
                                        TextColor="White" />
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                </Grid>

                <!-- ══════════════════════════════════════════ -->
                <!-- LEADERBOARD                                -->
                <!-- ══════════════════════════════════════════ -->
                <Border
                    Padding="20,22"
                    BackgroundColor="White"
                    Stroke="#CBDCEB"
                    StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#0F2D4A" Offset="0,6" Radius="20" Opacity="0.07" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">

                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                            <Label FontSize="15" Text="🏆" VerticalOptions="Center" />
                            <Label
                                CharacterSpacing="2.4"
                                FontAttributes="Bold"
                                FontSize="12"
                                Text="LEADERBOARD"
                                TextColor="#0F2D4A"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <BoxView
                            Margin="0,0,0,2"
                            BackgroundColor="#CBDCEB"
                            HeightRequest="1" />

                        <!-- First place -->
                        <Border
                            Padding="16,12"
                            BackgroundColor="#D6EAFF"
                            Stroke="#CBDCEB"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <PointerGestureRecognizer
                                    PointerEntered="OnPointerEntered"
                                    PointerExited="OnPointerExited"
                                    PointerPressed="OnPointerPressed"
                                    PointerReleased="OnPointerReleased" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Label Grid.Column="0" Margin="0,0,10,0" FontSize="20" Text="🥇" VerticalOptions="Center" />
                                <Label Grid.Column="1" FontAttributes="Bold" FontSize="15" Text="{Binding FirstPlayerName}" TextColor="#0F2D4A" VerticalOptions="Center" />
                                <Label Grid.Column="2" FontAttributes="Bold" FontSize="12" Text="{Binding FirstPlayerScore}" TextColor="#6B8CAE" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Second place -->
                        <Border
                            Padding="14,10"
                            BackgroundColor="White"
                            Stroke="#CBDCEB"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <PointerGestureRecognizer
                                    PointerEntered="OnPointerEntered"
                                    PointerExited="OnPointerExited"
                                    PointerPressed="OnPointerPressed"
                                    PointerReleased="OnPointerReleased" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Label Grid.Column="0" Margin="0,0,10,0" FontSize="16" Text="🥈" VerticalOptions="Center" />
                                <Label Grid.Column="1" FontSize="14" Text="{Binding SecondPlayerName}" TextColor="#0F2D4A" VerticalOptions="Center" />
                                <Label Grid.Column="2" FontAttributes="Bold" FontSize="12" Text="{Binding SecondPlayerScore}" TextColor="#6B8CAE" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Third place -->
                        <Border
                            Padding="14,10"
                            BackgroundColor="White"
                            Stroke="#CBDCEB"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <PointerGestureRecognizer
                                    PointerEntered="OnPointerEntered"
                                    PointerExited="OnPointerExited"
                                    PointerPressed="OnPointerPressed"
                                    PointerReleased="OnPointerReleased" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Label Grid.Column="0" Margin="0,0,10,0" FontSize="16" Text="🥉" VerticalOptions="Center" />
                                <Label Grid.Column="1" FontSize="14" Text="{Binding ThirdPlayerName}" TextColor="#0F2D4A" VerticalOptions="Center" />
                                <Label Grid.Column="2" FontAttributes="Bold" FontSize="12" Text="{Binding ThirdPlayerScore}" TextColor="#6B8CAE" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <!-- ══════════════════════════════════════════ -->
                <!-- QUOTE CARD                                 -->
                <!-- ══════════════════════════════════════════ -->
                <Border
                    Padding="22,18"
                    BackgroundColor="White"
                    Stroke="#CBDCEB"
                    StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#0F2D4A" Offset="0,4" Radius="12" Opacity="0.06" />
                    </Border.Shadow>
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                        <Label
                            Grid.Column="0"
                            Margin="0,-6,0,0"
                            FontSize="44"
                            Opacity="0.15"
                            Text="&#x201C;"
                            TextColor="#0F2D4A"
                            VerticalOptions="Start" />
                        <Label
                            Grid.Column="1"
                            FontAttributes="Italic"
                            FontSize="13"
                            LineBreakMode="WordWrap"
                            Text="&#x201C;Master reading comprehension with ease.&#x201D;"
                            TextColor="#6B8CAE"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
