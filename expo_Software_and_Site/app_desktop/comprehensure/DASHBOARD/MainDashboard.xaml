<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="comprehensure.DASHBOARD.MainDashboard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F2F6FB"
    Shell.NavBarIsVisible="False">

    <Grid>

        <Grid
            HorizontalOptions="Fill"
            InputTransparent="True"
            VerticalOptions="Fill">
            <Ellipse
                Margin="-80,-80,0,0"
                Fill="White"
                HeightRequest="320"
                HorizontalOptions="Start"
                Opacity="0.75"
                VerticalOptions="Start"
                WidthRequest="400" />
            <Ellipse
                Margin="0,0,-80,-40"
                Fill="#D6EAFF"
                HeightRequest="280"
                HorizontalOptions="End"
                Opacity="0.45"
                VerticalOptions="End"
                WidthRequest="320" />
        </Grid>

        <ScrollView>
            <VerticalStackLayout Padding="18,20,18,40" Spacing="16">

                <Border
                    Padding="20,18"
                    BackgroundColor="White"
                    Stroke="#CBDCEB"
                    StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow
                            Brush="#0F2D4A"
                            Opacity="0.07"
                            Radius="20"
                            Offset="0,6" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">

                        <Grid ColumnDefinitions="*, Auto">
                            <Label
                                Grid.Column="0"
                                CharacterSpacing="2.5"
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="DASHBOARD"
                                TextColor="#0F2D4A"
                                VerticalOptions="Center" />
                            <Border
                                Grid.Column="1"
                                BackgroundColor="Transparent"
                                Stroke="Transparent"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <PointerGestureRecognizer
                                        PointerEntered="OnPointerEntered"
                                        PointerExited="OnPointerExited"
                                        PointerPressed="OnPointerPressed"
                                        PointerReleased="OnPointerReleased" />
                                </Border.GestureRecognizers>
                                <ImageButton
                                    Command="{Binding ProfileDashboardCommand}"
                                    HeightRequest="28"
                                    Opacity="0.45"
                                    Source="settings.png"
                                    VerticalOptions="Center"
                                    WidthRequest="28" />
                            </Border>
                        </Grid>

                        <Grid
                            ColumnDefinitions="Auto, *, Auto"
                            ColumnSpacing="14"
                            VerticalOptions="Center">

                            <Border
                                Grid.Column="0"
                                BackgroundColor="#D6EAFF"
                                HeightRequest="56"
                                Stroke="#CBDCEB"
                                StrokeThickness="2"
                                WidthRequest="56">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="28" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow
                                        Brush="#0F2D4A"
                                        Opacity="0.08"
                                        Radius="8"
                                        Offset="0,3" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <PointerGestureRecognizer
                                        PointerEntered="OnPointerEntered"
                                        PointerExited="OnPointerExited"
                                        PointerPressed="OnPointerPressed"
                                        PointerReleased="OnPointerReleased" />
                                </Border.GestureRecognizers>
                                <ImageButton
                                    Aspect="AspectFill"
                                    Command="{Binding ProfileDashboardCommand}"
                                    Source="user.png" />
                            </Border>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2"
                                VerticalOptions="Center">
                                <Label
                                    CharacterSpacing="2.0"
                                    FontAttributes="Bold"
                                    FontSize="11"
                                    Text="WELCOME BACK,"
                                    TextColor="#0F2D4A" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="22"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding UsernameEdit}"
                                    TextColor="#0F2D4A" />
                            </VerticalStackLayout>

                            <Grid
                                Grid.Column="2"
                                ColumnDefinitions="Auto, Auto"
                                ColumnSpacing="12"
                                VerticalOptions="Center">
                                <VerticalStackLayout
                                    Grid.Column="0"
                                    Spacing="2"
                                    VerticalOptions="Center">
                                    <Label
                                        CharacterSpacing="1.2"
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        Text="{Binding ScoreDisplay}"
                                        TextColor="#0F2D4A" />
                                    <Label
                                        CharacterSpacing="1.4"
                                        FontAttributes="Bold"
                                        FontSize="8"
                                        Text="SCORE"
                                        TextColor="#6B8CAE" />
                                </VerticalStackLayout>
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    HorizontalOptions="Center"
                                    Spacing="4">
                                    <Grid HeightRequest="90" WidthRequest="90">
                                        <Ellipse
                                            Fill="Transparent"
                                            Stroke="#0F2D4A"
                                            StrokeThickness="10" />
                                        <Ellipse
                                            x:Name="DashboardProgressCircle"
                                            Fill="Transparent"
                                            Rotation="-90"
                                            Stroke="#D6EAFF"
                                            StrokeDashArray="25.133,25.133"
                                            StrokeDashOffset="{Binding StrokeOffset}"
                                            StrokeThickness="10" />
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="19"
                                            HorizontalOptions="Center"
                                            Text="{Binding DisplayPercentage}"
                                            TextColor="#0F2D4A"
                                            VerticalOptions="Center" />
                                    </Grid>
                                    <Label
                                        CharacterSpacing="1.4"
                                        FontAttributes="Bold"
                                        FontSize="8"
                                        HorizontalOptions="Center"
                                        Text="PROGRESS"
                                        TextColor="#6B8CAE" />
                                </VerticalStackLayout>
                            </Grid>

                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <Border
                    BackgroundColor="#0F2D4A"
                    Stroke="Transparent"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow
                            Brush="#0F2D4A"
                            Opacity="0.28"
                            Radius="28"
                            Offset="0,10" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <PointerGestureRecognizer
                            PointerEntered="OnPointerEntered"
                            PointerExited="OnPointerExited"
                            PointerPressed="OnPointerPressed"
                            PointerReleased="OnPointerReleased" />
                    </Border.GestureRecognizers>

                    <Grid RowDefinitions="Auto,Auto" RowSpacing="0">
                        <Border
                            Grid.Row="0"
                            Margin="0,10,0,0"
                            Padding="12,4"
                            HorizontalOptions="Center"
                            Stroke="#EBBF0C"
                            StrokeThickness="1">
                            <Border.Background>
                                <SolidColorBrush Color="#EBBF0C" />
                            </Border.Background>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <Label
                                CharacterSpacing="2.5"
                                FontAttributes="Bold"
                                FontSize="9"
                                HorizontalOptions="Center"
                                Text="★  START LEARNING"
                                TextColor="#FFFFFF" />
                        </Border>
                        <Button
                            Grid.Row="1"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            CharacterSpacing="3.5"
                            Command="{Binding modulesCommand}"
                            FontAttributes="Bold"
                            FontSize="22"
                            HeightRequest="70"
                            Text="📚  MODULES"
                            TextColor="White" />
                    </Grid>
                </Border>

                <Border
                    BackgroundColor="#0F2D4A"
                    Stroke="Transparent"
                    StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow
                            Brush="#0F2D4A"
                            Opacity="0.07"
                            Radius="12"
                            Offset="0,4" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <PointerGestureRecognizer
                            PointerEntered="OnPointerEntered"
                            PointerExited="OnPointerExited"
                            PointerPressed="OnPointerPressed"
                            PointerReleased="OnPointerReleased" />
                    </Border.GestureRecognizers>
                    <Button
                        BackgroundColor="#0F2D4A"
                        BorderWidth="0"
                        CharacterSpacing="2.0"
                        Command="{Binding AboutUsCommand}"
                        FontAttributes="Bold"
                        FontSize="20"
                        HeightRequest="70"
                        Text="ABOUT US"
                        TextColor="White" />
                </Border>

                <Border
                    Margin="0,4,0,0"
                    Stroke="#1E3A6B"
                    StrokeThickness="1.5">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#0A0F1E" />
                            <GradientStop Offset="1" Color="#0F1A30" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow
                            Brush="#4A90D9"
                            Opacity="0.18"
                            Radius="20"
                            Offset="0,6" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <PointerGestureRecognizer
                            PointerEntered="OnPointerEntered"
                            PointerExited="OnPointerExited"
                            PointerPressed="OnPointerPressed"
                            PointerReleased="OnPointerReleased" />
                    </Border.GestureRecognizers>
                    <Grid
                        Padding="16,14"
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="14">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMasterDictionaryClicked" />
                        </Grid.GestureRecognizers>
                        <Border
                            Grid.Column="0"
                            BackgroundColor="#0F1A30"
                            HeightRequest="48"
                            Stroke="#1E3A6B"
                            StrokeThickness="1"
                            WidthRequest="48">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <Label
                                FontSize="22"
                                HorizontalOptions="Center"
                                Text="📚"
                                VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="2"
                            VerticalOptions="Center">
                            <Label
                                CharacterSpacing="2.0"
                                FontAttributes="Bold"
                                FontSize="10"
                                Text="MASTER DICTIONARY"
                                TextColor="#4A90D9" />
                            <Label
                                FontSize="12"
                                Text="All words from Modules 1–8"
                                TextColor="#4A6A9A" />
                            <HorizontalStackLayout Margin="0,4,0,0" Spacing="6">
                                <Border
                                    Padding="7,3"
                                    BackgroundColor="#1B4A1B"
                                    Stroke="#2E7D32"
                                    StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="10"
                                        Text="🟢 Easy"
                                        TextColor="#A5D6A7" />
                                </Border>
                                <Border
                                    Padding="7,3"
                                    BackgroundColor="#3D3200"
                                    Stroke="#F9A825"
                                    StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="10"
                                        Text="🟡 Average"
                                        TextColor="#FFE082" />
                                </Border>
                                <Border
                                    Padding="7,3"
                                    BackgroundColor="#4A0F0F"
                                    Stroke="#C62828"
                                    StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="10"
                                        Text="🔴 Intermediate"
                                        TextColor="#EF9A9A" />
                                </Border>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Border>


                <HorizontalStackLayout Margin="4,4,4,0" Spacing="10">
                    <BoxView
                        BackgroundColor="#0F2D4A"
                        CornerRadius="2"
                        HeightRequest="20"
                        VerticalOptions="Center"
                        WidthRequest="4" />
                    <Label
                        CharacterSpacing="2.2"
                        FontAttributes="Bold"
                        FontSize="13"
                        Text="CHALLENGE ZONE"
                        TextColor="#0F2D4A"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Border
                    Padding="16,10"
                    BackgroundColor="#FFF3E0"
                    IsVisible="{Binding IsMinigameLocked}"
                    Stroke="#FFCC80"
                    StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Label
                        FontAttributes="Bold"
                        FontSize="12"
                        HorizontalOptions="Center"
                        Text="🔒  Complete Module 3 to unlock Mini-Games"
                        TextColor="#E65100" />
                </Border>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="14">

                    <Border
                        Grid.Column="0"
                        Padding="0,0,0,20"
                        BackgroundColor="White"
                        IsEnabled="{Binding IsMinigameUnlocked}"
                        Opacity="{Binding MinigameOpacity}"
                        Stroke="#CBDCEB"
                        StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow
                                Brush="#0F2D4A"
                                Opacity="0.07"
                                Radius="18"
                                Offset="0,6" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <PointerGestureRecognizer
                                PointerEntered="OnPointerEntered"
                                PointerExited="OnPointerExited"
                                PointerPressed="OnPointerPressed"
                                PointerReleased="OnPointerReleased" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="0">
                            <Border
                                HeightRequest="160"
                                Stroke="Transparent"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="24,24,0,0" />
                                </Border.StrokeShape>
                                <Image
                                    Aspect="AspectFill"
                                    HorizontalOptions="Fill"
                                    Source="synonym_thumb.png"
                                    VerticalOptions="Fill" />
                            </Border>
                            <VerticalStackLayout
                                Margin="14,12,14,0"
                                HorizontalOptions="Center"
                                Spacing="8">
                                <Label
                                    CharacterSpacing="1.2"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    HorizontalOptions="Center"
                                    Text="SYNONYM HUNT"
                                    TextColor="#0F2D4A" />
                                <Label
                                    FontSize="11"
                                    HorizontalTextAlignment="Center"
                                    LineBreakMode="WordWrap"
                                    Text="Match words with the same meaning"
                                    TextColor="#6B8CAE" />
                                <Border
                                    Margin="0,4,0,0"
                                    BackgroundColor="#0F2D4A"
                                    IsEnabled="{Binding IsMinigameUnlocked}"
                                    Stroke="Transparent"
                                    StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="22" />
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow
                                            Brush="#0F2D4A"
                                            Opacity="0.22"
                                            Radius="10"
                                            Offset="0,4" />
                                    </Border.Shadow>
                                    <Border.GestureRecognizers>
                                        <PointerGestureRecognizer
                                            PointerEntered="OnPointerEntered"
                                            PointerExited="OnPointerExited"
                                            PointerPressed="OnPointerPressed"
                                            PointerReleased="OnPointerReleased" />
                                    </Border.GestureRecognizers>
                                    <Button
                                        BackgroundColor="Transparent"
                                        BorderWidth="0"
                                        CharacterSpacing="1.0"
                                        Clicked="OnSynonymHuntClicked"
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        HeightRequest="44"
                                        Text="PLAY"
                                        TextColor="White" />
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Padding="0,0,0,20"
                        BackgroundColor="White"
                        IsEnabled="{Binding IsMinigameUnlocked}"
                        Opacity="{Binding MinigameOpacity}"
                        Stroke="#CBDCEB"
                        StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow
                                Brush="#0F2D4A"
                                Opacity="0.07"
                                Radius="18"
                                Offset="0,6" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <PointerGestureRecognizer
                                PointerEntered="OnPointerEntered"
                                PointerExited="OnPointerExited"
                                PointerPressed="OnPointerPressed"
                                PointerReleased="OnPointerReleased" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="0">
                            <Border
                                HeightRequest="160"
                                Stroke="Transparent"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="24,24,0,0" />
                                </Border.StrokeShape>
                                <Image
                                    Aspect="AspectFill"
                                    HorizontalOptions="Fill"
                                    Source="theme_thumb.png"
                                    VerticalOptions="Fill" />
                            </Border>
                            <VerticalStackLayout
                                Margin="14,12,14,0"
                                HorizontalOptions="Center"
                                Spacing="8">
                                <Label
                                    CharacterSpacing="1.2"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    HorizontalOptions="Center"
                                    Text="4 PICS 1 THEME"
                                    TextColor="#0F2D4A" />
                                <Label
                                    FontSize="11"
                                    HorizontalTextAlignment="Center"
                                    LineBreakMode="WordWrap"
                                    Text="Guess the theme from four image clues"
                                    TextColor="#6B8CAE" />
                                <Border
                                    Margin="0,4,0,0"
                                    BackgroundColor="#0F2D4A"
                                    Stroke="Transparent"
                                    StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="22" />
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow
                                            Brush="#0F2D4A"
                                            Opacity="0.22"
                                            Radius="10"
                                            Offset="0,4" />
                                    </Border.Shadow>
                                    <Border.GestureRecognizers>
                                        <PointerGestureRecognizer
                                            PointerEntered="OnPointerEntered"
                                            PointerExited="OnPointerExited"
                                            PointerPressed="OnPointerPressed"
                                            PointerReleased="OnPointerReleased" />
                                    </Border.GestureRecognizers>
                                    <Button
                                        BackgroundColor="Transparent"
                                        BorderWidth="0"
                                        CharacterSpacing="1.0"
                                        Clicked="OnOneWordClicked"
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        HeightRequest="44"
                                        Text="PLAY"
                                        TextColor="White" />
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                </Grid>

                <Border
                    Padding="20,22"
                    BackgroundColor="White"
                    Stroke="#CBDCEB"
                    StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow
                            Brush="#0F2D4A"
                            Opacity="0.07"
                            Radius="20"
                            Offset="0,6" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">

                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                            <Label
                                FontSize="15"
                                Text="🏆"
                                VerticalOptions="Center" />
                            <Label
                                CharacterSpacing="2.4"
                                FontAttributes="Bold"
                                FontSize="12"
                                Text="LEADERBOARD"
                                TextColor="#0F2D4A"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <BoxView
                            Margin="0,0,0,2"
                            BackgroundColor="#CBDCEB"
                            HeightRequest="1" />

                        <Border
                            Padding="16,12"
                            BackgroundColor="#D6EAFF"
                            Stroke="#CBDCEB"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <PointerGestureRecognizer
                                    PointerEntered="OnPointerEntered"
                                    PointerExited="OnPointerExited"
                                    PointerPressed="OnPointerPressed"
                                    PointerReleased="OnPointerReleased" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Label
                                    Grid.Column="0"
                                    Margin="0,0,10,0"
                                    FontSize="20"
                                    Text="🥇"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontAttributes="Bold"
                                    FontSize="15"
                                    Text="{Binding FirstPlayerName}"
                                    TextColor="#0F2D4A"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="2"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    Text="{Binding FirstPlayerScore}"
                                    TextColor="#6B8CAE"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Border
                            Padding="14,10"
                            BackgroundColor="White"
                            Stroke="#CBDCEB"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <PointerGestureRecognizer
                                    PointerEntered="OnPointerEntered"
                                    PointerExited="OnPointerExited"
                                    PointerPressed="OnPointerPressed"
                                    PointerReleased="OnPointerReleased" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Label
                                    Grid.Column="0"
                                    Margin="0,0,10,0"
                                    FontSize="16"
                                    Text="🥈"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontSize="14"
                                    Text="{Binding SecondPlayerName}"
                                    TextColor="#0F2D4A"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="2"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    Text="{Binding SecondPlayerScore}"
                                    TextColor="#6B8CAE"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Border
                            Padding="14,10"
                            BackgroundColor="White"
                            Stroke="#CBDCEB"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <PointerGestureRecognizer
                                    PointerEntered="OnPointerEntered"
                                    PointerExited="OnPointerExited"
                                    PointerPressed="OnPointerPressed"
                                    PointerReleased="OnPointerReleased" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Label
                                    Grid.Column="0"
                                    Margin="0,0,10,0"
                                    FontSize="16"
                                    Text="🥉"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontSize="14"
                                    Text="{Binding ThirdPlayerName}"
                                    TextColor="#0F2D4A"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="2"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    Text="{Binding ThirdPlayerScore}"
                                    TextColor="#6B8CAE"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <Border
                    Padding="22,18"
                    BackgroundColor="White"
                    Stroke="#CBDCEB"
                    StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow
                            Brush="#0F2D4A"
                            Opacity="0.06"
                            Radius="12"
                            Offset="0,4" />
                    </Border.Shadow>
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                        <Label
                            Grid.Column="0"
                            Margin="0,-6,0,0"
                            FontSize="44"
                            Opacity="0.15"
                            Text="&#x201C;"
                            TextColor="#0F2D4A"
                            VerticalOptions="Start" />
                        <Label
                            Grid.Column="1"
                            FontAttributes="Italic"
                            FontSize="13"
                            LineBreakMode="WordWrap"
                            Text="&#x201C;Master reading comprehension with ease.&#x201D;"
                            TextColor="#6B8CAE"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
