                                               TextColor="#0B2540" />
                                        <Label Text="Leader"
                                               FontSize="12" FontAttributes="Bold"
                                               TextColor="#5A7FA0" CharacterSpacing="0.8" />
                                    </VerticalStackLayout>
                                </Grid>
