<ContentPage
    x:Class="comprehensure.DASHBOARD.AboutUs"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#D6EAFF"
    Shell.NavBarIsVisible="False">

    <Grid>

        <!-- Background decorative blobs -->
        <Grid HorizontalOptions="Fill" VerticalOptions="Fill" InputTransparent="True">
            <Ellipse
                Fill="White"
                WidthRequest="580" HeightRequest="440"
                HorizontalOptions="Start" VerticalOptions="Start"
                Margin="-140,-110,0,0" Opacity="0.75" />
            <Ellipse
                Fill="#D6EAFF"
                WidthRequest="460" HeightRequest="380"
                HorizontalOptions="End" VerticalOptions="End"
                Margin="0,0,-110,-60" Opacity="0.45" />
        </Grid>

        <ScrollView HorizontalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="24" Padding="56,36,56,56"
                                 HorizontalOptions="Fill">

                <!-- ══════════════════════════════════════ -->
                <!--  TOP BAR — back + title               -->
                <!-- ══════════════════════════════════════ -->
                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14" HorizontalOptions="Fill">

                    <!-- Back button -->
                    <Border Grid.Column="0"
                            BackgroundColor="White" Stroke="#AECDE8" StrokeThickness="1"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#0F2D4A" Offset="0,4" Radius="12" Opacity="0.08" />
                        </Border.Shadow>
                        <Button Text="← Back"
                                Command="{Binding BackCommand}"
                                BackgroundColor="Transparent"
                                TextColor="#0F2D4A"
                                BorderWidth="0"
                                FontAttributes="Bold"
                                FontSize="13"
                                HeightRequest="44"
                                Padding="20,0" />
                    </Border>

                    <!-- Page title -->
                    <Label Grid.Column="1"
                           Text="ALL ABOUT US"
                           FontSize="38" FontAttributes="Bold"
                           TextColor="#0F2D4A" CharacterSpacing="2.2"
                           HorizontalOptions="Fill"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center" />

       
                </Grid>

                <!-- ══════════════════════════════════════ -->
                <!--  SECTION LABEL                        -->
                <!-- ══════════════════════════════════════ -->
                <Label Text="Our Team Pyramid"
                       FontSize="13" FontAttributes="Bold"
                       TextColor="#0F2D4A" CharacterSpacing="1.5"
                       HorizontalOptions="Center"
                       Opacity="0.70" />

                <!-- ══════════════════════════════════════ -->
                <!--  PYRAMID CARD CONTAINER               -->
                <!-- ══════════════════════════════════════ -->
                <Border BackgroundColor="White"
                        Stroke="#AECDE8" StrokeThickness="1.5"
                        Padding="48,44"
                        HorizontalOptions="Fill">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="36" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#0F2D4A" Offset="0,10" Radius="32" Opacity="0.10" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="28" HorizontalOptions="Fill">

                        <!-- ─────────────────────────── -->
                        <!--  ROW 1 — Apex: Fren         -->
                        <!-- ─────────────────────────── -->
                        <VerticalStackLayout Spacing="0" HorizontalOptions="Fill">
                            <Border BackgroundColor="#D6EAFF"
                                    Stroke="#AECDE8" StrokeThickness="1.5"
                                    HorizontalOptions="Fill" HeightRequest="230">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#0F2D4A" Offset="0,6" Radius="16" Opacity="0.10" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnMemberTapped" CommandParameter="Fren" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="6">
                                    <Border WidthRequest="120" HeightRequest="120"
                                            HorizontalOptions="Center"
                                            Stroke="#AECDE8" StrokeThickness="1.5"
                                            BackgroundColor="#D6EAFF">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="60" />
                                        </Border.StrokeShape>
                                        <Image Source="member_fren.jpg"
                                               Aspect="AspectFill"
                                               HorizontalOptions="Fill"
                                               VerticalOptions="Fill" />
                                    </Border>
                                    <Label Text="Mariano, Frenchelle A."
                                           FontSize="20" FontAttributes="Bold"
                                           TextColor="#0F2D4A"
                                           HorizontalOptions="Center" />
                                    <Label Text="Leader"
                                           FontSize="20"
                                           TextColor="#4A7FA8"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Inline description — Fren -->
                            <Border x:Name="Desc_Fren"
                                    IsVisible="False"
                                    BackgroundColor="#EEF5FF"
                                    Stroke="#AECDE8" StrokeThickness="1"
                                    Padding="18,14"
                                    Margin="0,6,0,0"
                                    HorizontalOptions="Fill">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <Label x:Name="DescLabel_Fren"
                                       FontSize="15" TextColor="#4A6580"
                                       LineBreakMode="WordWrap"
                                       HorizontalOptions="Fill" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Connector line row 1→2 -->
                        <BoxView HeightRequest="1" BackgroundColor="#AECDE8" Margin="40,0" />

                        <!-- ─────────────────────────── -->
                        <!--  ROW 2 — Franz and Abbey    -->
                        <!-- ─────────────────────────── -->
                        <VerticalStackLayout Spacing="0" HorizontalOptions="Fill">
                            <Grid ColumnDefinitions="*, Auto, *" ColumnSpacing="20" HorizontalOptions="Fill">

                                <!-- Franz -->
                                <VerticalStackLayout Grid.Column="0" Spacing="0">
                                    <Border BackgroundColor="#EEF5FF"
                                            Stroke="#AECDE8" StrokeThickness="1.5"
                                            HorizontalOptions="Fill" HeightRequest="230">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="20" />
                                        </Border.StrokeShape>
                                        <Border.Shadow>
                                            <Shadow Brush="#0F2D4A" Offset="0,6" Radius="16" Opacity="0.09" />
                                        </Border.Shadow>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnMemberTapped" CommandParameter="Franz" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="6">
                                            <Border WidthRequest="120" HeightRequest="120"
                                                    HorizontalOptions="Center"
                                                    Stroke="#AECDE8" StrokeThickness="1.5"
                                                    BackgroundColor="#EEF5FF">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="60" />
                                                </Border.StrokeShape>
                                                <Image Source="member_franz.jpg"
                                                       Aspect="AspectFill"
                                                       HorizontalOptions="Fill"
                                                       VerticalOptions="Fill" />
                                            </Border>
                                            <Label Text="Pardilla, Franz Louie D"
                                                   FontSize="20" FontAttributes="Bold"
                                                   TextColor="#0F2D4A"
                                                   HorizontalOptions="Center" />
                                            <Label Text="Backend and Database Developer"
                                                   FontSize="20"
                                                   TextColor="#4A7FA8"
                                                   HorizontalOptions="Center"
                                                   HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <!-- Inline description — Franz -->
                                    <Border x:Name="Desc_Franz"
                                            IsVisible="False"
                                            BackgroundColor="#EEF5FF"
                                            Stroke="#AECDE8" StrokeThickness="1"
                                            Padding="18,14"
                                            Margin="0,6,0,0"
                                            HorizontalOptions="Fill">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>
                                        <Label x:Name="DescLabel_Franz"
                                               FontSize="15" TextColor="#4A6580"
                                               LineBreakMode="WordWrap"
                                               HorizontalOptions="Fill" />
                                    </Border>
                                </VerticalStackLayout>

                                <!-- Spacer / central gap -->
                                <BoxView Grid.Column="1" WidthRequest="40" Color="Transparent" />

                                <!-- Abbey -->
                                <VerticalStackLayout Grid.Column="2" Spacing="0">
                                    <Border BackgroundColor="#EEF5FF"
                                            Stroke="#AECDE8" StrokeThickness="1.5"
                                            HorizontalOptions="Fill" HeightRequest="230">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="20" />
                                        </Border.StrokeShape>
                                        <Border.Shadow>
                                            <Shadow Brush="#0F2D4A" Offset="0,6" Radius="16" Opacity="0.09" />
                                        </Border.Shadow>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnMemberTapped" CommandParameter="Abbey" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="6">
                                            <Border WidthRequest="120" HeightRequest="120"
                                                    HorizontalOptions="Center"
                                                    Stroke="#AECDE8" StrokeThickness="1.5"
                                                    BackgroundColor="#EEF5FF">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="60" />
                                                </Border.StrokeShape>
                                                <Image Source="member_abbey.jpg"
                                                       Aspect="AspectFill"
                                                       HorizontalOptions="Fill"
                                                       VerticalOptions="Fill" />
                                            </Border>
                                            <Label Text="Abata, Abbey Anmae A."
                                                   FontSize="20" FontAttributes="Bold"
                                                   TextColor="#0F2D4A"
                                                   HorizontalOptions="Center" />
                                            <Label Text="UI/UX Designer"
                                                   FontSize="20"
                                                   TextColor="#4A7FA8"
                                                   HorizontalOptions="Center"
                                                   HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <!-- Inline description — Abbey -->
                                    <Border x:Name="Desc_Abbey"
                                            IsVisible="False"
                                            BackgroundColor="#EEF5FF"
                                            Stroke="#AECDE8" StrokeThickness="1"
                                            Padding="18,14"
                                            Margin="0,6,0,0"
                                            HorizontalOptions="Fill">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>
                                        <Label x:Name="DescLabel_Abbey"
                                               FontSize="15" TextColor="#4A6580"
                                               LineBreakMode="WordWrap"
                                               HorizontalOptions="Fill" />
                                    </Border>
                                </VerticalStackLayout>

                            </Grid>
                        </VerticalStackLayout>

                        <!-- Connector line row 2→3 -->
                        <BoxView HeightRequest="1" BackgroundColor="#AECDE8" Margin="20,0" />

                        <!-- ─────────────────────────── -->
                        <!--  ROW 3 — Japlyn, York, Abram -->
                        <!-- ─────────────────────────── -->
                        <VerticalStackLayout Spacing="0" HorizontalOptions="Fill">
                            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="16" HorizontalOptions="Fill">

                                <!-- Japlyn -->
                                <VerticalStackLayout Grid.Column="0" Spacing="0">
                                    <Border BackgroundColor="#EEF5FF"
                                            Stroke="#AECDE8" StrokeThickness="1"
                                            HorizontalOptions="Fill" HeightRequest="220">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="18" />
                                        </Border.StrokeShape>
                                        <Border.Shadow>
                                            <Shadow Brush="#0F2D4A" Offset="0,4" Radius="12" Opacity="0.07" />
                                        </Border.Shadow>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnMemberTapped" CommandParameter="Japlyn" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="6">
                                            <Border WidthRequest="110" HeightRequest="110"
                                                    HorizontalOptions="Center"
                                                    Stroke="#AECDE8" StrokeThickness="1.5"
                                                    BackgroundColor="#EEF5FF">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="55" />
                                                </Border.StrokeShape>
                                                <Image Source="member_japlyn.jpg"
                                                       Aspect="AspectFill"
                                                       HorizontalOptions="Fill"
                                                       VerticalOptions="Fill" />
                                            </Border>
                                            <Label Text="Gutierrez,Japlyn N."
                                                   FontSize="20" FontAttributes="Bold"
                                                   TextColor="#0F2D4A"
                                                   HorizontalOptions="Center" />
                                            <Label Text="Content Developer"
                                                   FontSize="20"
                                                   TextColor="#4A7FA8"
                                                   HorizontalOptions="Center"
                                                   HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <!-- Inline description — Japlyn -->
                                    <Border x:Name="Desc_Japlyn"
                                            IsVisible="False"
                                            BackgroundColor="#EEF5FF"
                                            Stroke="#AECDE8" StrokeThickness="1"
                                            Padding="14,12"
                                            Margin="0,6,0,0"
                                            HorizontalOptions="Fill">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Label x:Name="DescLabel_Japlyn"
                                               FontSize="15" TextColor="#4A6580"
                                               LineBreakMode="WordWrap"
                                               HorizontalOptions="Fill" />
                                    </Border>
                                </VerticalStackLayout>

                                <!-- York -->
                                <VerticalStackLayout Grid.Column="1" Spacing="0">
                                    <Border BackgroundColor="#EEF5FF"
                                            Stroke="#AECDE8" StrokeThickness="1"
                                            HorizontalOptions="Fill" HeightRequest="220">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="18" />
                                        </Border.StrokeShape>
                                        <Border.Shadow>
                                            <Shadow Brush="#0F2D4A" Offset="0,4" Radius="12" Opacity="0.07" />
                                        </Border.Shadow>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnMemberTapped" CommandParameter="York" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="6">
                                            <Border WidthRequest="110" HeightRequest="110"
                                                    HorizontalOptions="Center"
                                                    Stroke="#AECDE8" StrokeThickness="1.5"
                                                    BackgroundColor="#EEF5FF">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="55" />
                                                </Border.StrokeShape>
                                                <Image Source="member_york.jpg"
                                                       Aspect="AspectFill"
                                                       HorizontalOptions="Fill"
                                                       VerticalOptions="Fill" />
                                            </Border>
                                            <Label Text="Tan, York Stephen M."
                                                   FontSize="20" FontAttributes="Bold"
                                                   TextColor="#0F2D4A"
                                                   HorizontalOptions="Center" />
                                            <Label Text="Content Developer"
                                                   FontSize="20"
                                                   TextColor="#4A7FA8"
                                                   HorizontalOptions="Center"
                                                   HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <!-- Inline description — York -->
                                    <Border x:Name="Desc_York"
                                            IsVisible="False"
                                            BackgroundColor="#EEF5FF"
                                            Stroke="#AECDE8" StrokeThickness="1"
                                            Padding="14,12"
                                            Margin="0,6,0,0"
                                            HorizontalOptions="Fill">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Label x:Name="DescLabel_York"
                                               FontSize="15" TextColor="#4A6580"
                                               LineBreakMode="WordWrap"
                                               HorizontalOptions="Fill" />
                                    </Border>
                                </VerticalStackLayout>

                                <!-- Abram -->
                                <VerticalStackLayout Grid.Column="2" Spacing="0">
                                    <Border BackgroundColor="#EEF5FF"
                                            Stroke="#AECDE8" StrokeThickness="1"
                                            HorizontalOptions="Fill" HeightRequest="220">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="18" />
                                        </Border.StrokeShape>
                                        <Border.Shadow>
                                            <Shadow Brush="#0F2D4A" Offset="0,4" Radius="12" Opacity="0.07" />
                                        </Border.Shadow>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnMemberTapped" CommandParameter="Abram" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="6">
                                            <Border WidthRequest="110" HeightRequest="110"
                                                    HorizontalOptions="Center"
                                                    Stroke="#AECDE8" StrokeThickness="1.5"
                                                    BackgroundColor="#EEF5FF">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="55" />
                                                </Border.StrokeShape>
                                                <Image Source="member_abram.jpg"
                                                       Aspect="AspectFill"
                                                       HorizontalOptions="Fill"
                                                       VerticalOptions="Fill" />
                                            </Border>
                                            <Label Text="Mendoza, Abram M."
                                                   FontSize="20" FontAttributes="Bold"
                                                   TextColor="#0F2D4A"
                                                   HorizontalOptions="Center" />
                                            <Label Text="Content Developer"
                                                   FontSize="20"
                                                   TextColor="#4A7FA8"
                                                   HorizontalOptions="Center"
                                                   HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <!-- Inline description — Abram -->
                                    <Border x:Name="Desc_Abram"
                                            IsVisible="False"
                                            BackgroundColor="#EEF5FF"
                                            Stroke="#AECDE8" StrokeThickness="1"
                                            Padding="14,12"
                                            Margin="0,6,0,0"
                                            HorizontalOptions="Fill">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Label x:Name="DescLabel_Abram"
                                               FontSize="15" TextColor="#4A6580"
                                               LineBreakMode="WordWrap"
                                               HorizontalOptions="Fill" />
                                    </Border>
                                </VerticalStackLayout>

                            </Grid>
                        </VerticalStackLayout>

                        <!-- Connector line row 3→4 -->
                        <BoxView HeightRequest="1" BackgroundColor="#AECDE8" Margin="0,0" />

                        <!-- ─────────────────────────── -->
                        <!--  ROW 4 — Charly, Daniel, Megan -->
                        <!-- ─────────────────────────── -->
                        <VerticalStackLayout Spacing="0" HorizontalOptions="Fill">
                            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="16" HorizontalOptions="Fill">

                                <!-- Charly -->
                                <VerticalStackLayout Grid.Column="0" Spacing="0">
                                    <Border BackgroundColor="#EEF5FF"
                                            Stroke="#AECDE8" StrokeThickness="1"
                                            HorizontalOptions="Fill" HeightRequest="220">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="18" />
                                        </Border.StrokeShape>
                                        <Border.Shadow>
                                            <Shadow Brush="#0F2D4A" Offset="0,4" Radius="12" Opacity="0.06" />
                                        </Border.Shadow>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnMemberTapped" CommandParameter="Charly" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="6">
                                            <Border WidthRequest="110" HeightRequest="110"
                                                    HorizontalOptions="Center"
                                                    Stroke="#AECDE8" StrokeThickness="1.5"
                                                    BackgroundColor="#EEF5FF">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="55" />
                                                </Border.StrokeShape>
                                                <Image Source="member_charly.jpg"
                                                       Aspect="AspectFill"
                                                       HorizontalOptions="Fill"
                                                       VerticalOptions="Fill" />
                                            </Border>
                                            <Label Text="Pamplona, Charly Vincent L."
                                                   FontSize="20" FontAttributes="Bold"
                                                   TextColor="#0F2D4A"
                                                   HorizontalOptions="Center" />
                                            <Label Text="Researcher"
                                                   FontSize="20"
                                                   TextColor="#4A7FA8"
                                                   HorizontalOptions="Center"
                                                   HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <!-- Inline description — Charly -->
                                    <Border x:Name="Desc_Charly"
                                            IsVisible="False"
                                            BackgroundColor="#EEF5FF"
                                            Stroke="#AECDE8" StrokeThickness="1"
                                            Padding="14,12"
                                            Margin="0,6,0,0"
                                            HorizontalOptions="Fill">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Label x:Name="DescLabel_Charly"
                                               FontSize="15" TextColor="#4A6580"
                                               LineBreakMode="WordWrap"
                                               HorizontalOptions="Fill" />
                                    </Border>
                                </VerticalStackLayout>

                                <!-- Daniel -->
                                <VerticalStackLayout Grid.Column="1" Spacing="0">
                                    <Border BackgroundColor="#EEF5FF"
                                            Stroke="#AECDE8" StrokeThickness="1"
                                            HorizontalOptions="Fill" HeightRequest="220">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="18" />
                                        </Border.StrokeShape>
                                        <Border.Shadow>
                                            <Shadow Brush="#0F2D4A" Offset="0,4" Radius="12" Opacity="0.06" />
                                        </Border.Shadow>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnMemberTapped" CommandParameter="Daniel" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="6">
                                            <Border WidthRequest="110" HeightRequest="110"
                                                    HorizontalOptions="Center"
                                                    Stroke="#AECDE8" StrokeThickness="1.5"
                                                    BackgroundColor="#EEF5FF">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="55" />
                                                </Border.StrokeShape>
                                                <Image Source="member_daniel.jpg"
                                                       Aspect="AspectFill"
                                                       HorizontalOptions="Fill"
                                                       VerticalOptions="Fill" />
                                            </Border>
                                            <Label Text="Domingo, Daniel V."
                                                   FontSize="20" FontAttributes="Bold"
                                                   TextColor="#0F2D4A"
                                                   HorizontalOptions="Center" />
                                            <Label Text="Researcher"
                                                   FontSize="20"
                                                   TextColor="#4A7FA8"
                                                   HorizontalOptions="Center"
                                                   HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <!-- Inline description — Daniel -->
                                    <Border x:Name="Desc_Daniel"
                                            IsVisible="False"
                                            BackgroundColor="#EEF5FF"
                                            Stroke="#AECDE8" StrokeThickness="1"
                                            Padding="14,12"
                                            Margin="0,6,0,0"
                                            HorizontalOptions="Fill">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Label x:Name="DescLabel_Daniel"
                                               FontSize="15" TextColor="#4A6580"
                                               LineBreakMode="WordWrap"
                                               HorizontalOptions="Fill" />
                                    </Border>
                                </VerticalStackLayout>

                                <!-- Megan -->
                                <VerticalStackLayout Grid.Column="2" Spacing="0">
                                    <Border BackgroundColor="#EEF5FF"
                                            Stroke="#AECDE8" StrokeThickness="1"
                                            HorizontalOptions="Fill" HeightRequest="220">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="18" />
                                        </Border.StrokeShape>
                                        <Border.Shadow>
                                            <Shadow Brush="#0F2D4A" Offset="0,4" Radius="12" Opacity="0.06" />
                                        </Border.Shadow>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnMemberTapped" CommandParameter="Megan" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="6">
                                            <Border WidthRequest="110" HeightRequest="110"
                                                    HorizontalOptions="Center"
                                                    Stroke="#AECDE8" StrokeThickness="1.5"
                                                    BackgroundColor="#EEF5FF">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="55" />
                                                </Border.StrokeShape>
                                                <Image Source="member_megan.jpg"
                                                       Aspect="AspectFill"
                                                       HorizontalOptions="Fill"
                                                       VerticalOptions="Fill" />
                                            </Border>
                                            <Label Text="Candatu, Megan Jessie"
                                                   FontSize="20" FontAttributes="Bold"
                                                   TextColor="#0F2D4A"
                                                   HorizontalOptions="Center" />
                                            <Label Text="Researcher"
                                                   FontSize="20"
                                                   TextColor="#4A7FA8"
                                                   HorizontalOptions="Center"
                                                   HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <!-- Inline description — Megan -->
                                    <Border x:Name="Desc_Megan"
                                            IsVisible="False"
                                            BackgroundColor="#EEF5FF"
                                            Stroke="#AECDE8" StrokeThickness="1"
                                            Padding="14,12"
                                            Margin="0,6,0,0"
                                            HorizontalOptions="Fill">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12"   />
                                        </Border.StrokeShape>
                                        <Label x:Name="DescLabel_Megan"
                                               FontSize="15" TextColor="#4A6580"
                                               LineBreakMode="WordWrap"
                                               HorizontalOptions="Fill" />
                                    </Border>
                                </VerticalStackLayout>

                            </Grid>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
