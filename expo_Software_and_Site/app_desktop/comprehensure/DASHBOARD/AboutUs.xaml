<ContentPage
    x:Class="comprehensure.DASHBOARD.AboutUs"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#EEF4FB"
    Shell.NavBarIsVisible="False">

    <Grid>

        <!-- Background decorative blobs -->
        <Grid HorizontalOptions="Fill" VerticalOptions="Fill" InputTransparent="True">
            <Ellipse
                Fill="White"
                WidthRequest="620" HeightRequest="480"
                HorizontalOptions="Start" VerticalOptions="Start"
                Margin="-160,-130,0,0" Opacity="0.65" />
            <Ellipse
                Fill="#C8E2FF"
                WidthRequest="500" HeightRequest="420"
                HorizontalOptions="End" VerticalOptions="End"
                Margin="0,0,-130,-80" Opacity="0.45" />
            <Ellipse
                Fill="#D6EAFF"
                WidthRequest="260" HeightRequest="260"
                HorizontalOptions="Center" VerticalOptions="Start"
                Margin="0,60,0,0" Opacity="0.30" />
        </Grid>

        <ScrollView HorizontalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="20" Padding="20,32,20,56"
                                 HorizontalOptions="Fill">

                <!-- ══════════════════════════════════════ -->
                <!--  TOP BAR — back + title               -->
                <!-- ══════════════════════════════════════ -->
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14" HorizontalOptions="Fill">

                    <!-- Back button -->
                    <Border Grid.Column="0"
                            BackgroundColor="White" Stroke="#BDD4E8" StrokeThickness="1"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#0F2D4A" Offset="0,3" Radius="10" Opacity="0.07" />
                        </Border.Shadow>
                        <Button Text="← Back"
                                Command="{Binding BackCommand}"
                                BackgroundColor="Transparent"
                                TextColor="#0F2D4A"
                                BorderWidth="0"
                                FontAttributes="Bold"
                                FontSize="13"
                                HeightRequest="42"
                                Padding="18,0" />
                    </Border>

                    <!-- Page title -->
                    <Label Grid.Column="1"
                           Text="ALL ABOUT US"
                           FontSize="26" FontAttributes="Bold"
                           TextColor="#0B2540" CharacterSpacing="3.0"
                           HorizontalOptions="Fill"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center" />
                </Grid>

                <!-- ══════════════════════════════════════ -->
                <!--  SECTION LABEL                        -->
                <!-- ══════════════════════════════════════ -->
                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Label Text="OUR TEAM"
                           FontSize="11" FontAttributes="Bold"
                           TextColor="#5A7FA0" CharacterSpacing="3.0"
                           HorizontalOptions="Center" />
                    <BoxView WidthRequest="36" HeightRequest="2"
                             Color="#4A9EDB" CornerRadius="1"
                             HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- ══════════════════════════════════════ -->
                <!--  VERTICAL MEMBER CARD LIST            -->
                <!-- ══════════════════════════════════════ -->
                <Border BackgroundColor="White"
                        Stroke="#C4D8EC" StrokeThickness="1"
                        Padding="20,28"
                        HorizontalOptions="Fill">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#0B2540" Offset="0,8" Radius="36" Opacity="0.09" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16" HorizontalOptions="Fill">

                        <!-- ─────────────────────────── -->
                        <!--  Fren — Leader              -->
                        <!-- ─────────────────────────── -->
