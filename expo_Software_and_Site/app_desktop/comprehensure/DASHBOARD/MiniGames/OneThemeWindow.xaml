<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="comprehensure.DASHBOARD.MiniGames.OneThemeWindow"
    BackgroundColor="#F2F6FB"
    Shell.NavBarIsVisible="False">

    <Grid>

        <!-- Background decorative blobs — matches MainDashboard exactly -->
        <Grid HorizontalOptions="Fill" VerticalOptions="Fill" InputTransparent="True">
            <Ellipse
                Fill="White"
                WidthRequest="580" HeightRequest="440"
                HorizontalOptions="Start" VerticalOptions="Start"
                Margin="-140,-110,0,0" Opacity="0.75" />
            <Ellipse
                Fill="#D6EAFF"
                WidthRequest="460" HeightRequest="380"
                HorizontalOptions="End" VerticalOptions="End"
                Margin="0,0,-110,-60" Opacity="0.45" />
        </Grid>

        <ScrollView>
            <Grid Padding="36,28,36,48" RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ══════════════════════════════════════════ -->
                <!-- ROW 0 — HEADER CARD                        -->
                <!-- ══════════════════════════════════════════ -->
                <Border
                    Grid.Row="0"
                    Padding="24,20"
                    BackgroundColor="White"
                    Stroke="#CBDCEB"
                    StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="32" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#0F2D4A" Offset="0,8" Radius="24" Opacity="0.07" />
                    </Border.Shadow>

                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="20">

                        <!-- Profile section -->
                        <HorizontalStackLayout
                            Grid.Column="0"
                            Spacing="14"
                            VerticalOptions="Center">
                            <Border
                                BackgroundColor="#D6EAFF"
                                HeightRequest="60"
                                Stroke="#CBDCEB"
                                StrokeThickness="2"
                                WidthRequest="60">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="30" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#0F2D4A" Offset="0,3" Radius="10" Opacity="0.08" />
                                </Border.Shadow>
                                <Image Aspect="AspectFill" Source="user.png" />
                            </Border>
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label
                                    CharacterSpacing="2.0"
                                    FontAttributes="Bold"
                                    FontSize="9"
                                    Text="WELCOME BACK,"
                                    TextColor="#6B8CAE" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="20"
                                    Text="{Binding UsernameEdit}"
                                    TextColor="#0F2D4A" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <!-- Centre title -->
                        <VerticalStackLayout
                            Grid.Column="1"
                            HorizontalOptions="FillAndExpand"
                            Spacing="2"
                            VerticalOptions="Center">
                            <Label
                                FontAttributes="Bold"
                                FontSize="30"
                                HorizontalOptions="Fill"
                                HorizontalTextAlignment="Center"
                                CharacterSpacing="1.5"
                                Text="4 Pics 1 Theme"
                                TextColor="#0F2D4A" />
                            <Label
                                FontAttributes="Italic"
                                FontSize="13"
                                HorizontalOptions="Fill"
                                HorizontalTextAlignment="Center"
                                Text="comprehensure"
                                TextColor="#6B8CAE" />
                        </VerticalStackLayout>

                    </Grid>
                </Border>

                <!-- ══════════════════════════════════════════ -->
                <!-- ROW 1 — LOCKED MESSAGE CARD               -->
                <!-- ══════════════════════════════════════════ -->
                <Border
                    Grid.Row="1"
                    Padding="40,52"
                    BackgroundColor="White"
                    Stroke="#CBDCEB"
                    StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="32" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#0F2D4A" Offset="0,8" Radius="24" Opacity="0.07" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="28" HorizontalOptions="Center">

                        <!-- Lock icon -->
                        <Border
                            BackgroundColor="#D6EAFF"
                            HeightRequest="110"
                            WidthRequest="110"
                            HorizontalOptions="Center"
                            Stroke="#CBDCEB"
                            StrokeThickness="2">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="55" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#0F2D4A" Offset="0,6" Radius="18" Opacity="0.09" />
                            </Border.Shadow>
                            <Label
                                Text="🔒"
                                FontSize="48"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>

                        <!-- Main locked message -->
                        <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Label
                                FontAttributes="Bold"
                                FontSize="24"
                                HorizontalTextAlignment="Center"
                                Text="Content Locked"
                                TextColor="#0F2D4A" />
                            <Label
                                FontSize="15"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                Text="You cannot access 4 Pics 1 Theme until&#10;you complete Module 3."
                                TextColor="#6B8CAE" />
                        </VerticalStackLayout>

                        <!-- Divider -->
                        <BoxView BackgroundColor="#CBDCEB" HeightRequest="1" HorizontalOptions="Fill" />

                        <!-- Module 3 hint -->
                        <Border
                            Padding="22,16"
                            BackgroundColor="#F2F6FB"
                            Stroke="#CBDCEB"
                            StrokeThickness="1"
                            HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="22" />
                            </Border.StrokeShape>
                            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                                <Label Text="📚" FontSize="22" VerticalOptions="Center" />
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label
                                        CharacterSpacing="1.8"
                                        FontAttributes="Bold"
                                        FontSize="9"
                                        Text="NEXT STEP"
                                        TextColor="#6B8CAE" />
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        Text="Complete Module 3 to unlock this game"
                                        TextColor="#0F2D4A" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Quote card -->
                        <Border
                            Padding="28,22"
                            BackgroundColor="White"
                            Stroke="#CBDCEB"
                            StrokeThickness="1"
                            HorizontalOptions="Fill">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#0F2D4A" Offset="0,4" Radius="12" Opacity="0.06" />
                            </Border.Shadow>
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                                <Label
                                    Grid.Column="0"
                                    Margin="0,-8,0,0"
                                    FontSize="52"
                                    Opacity="0.15"
                                    Text="&#x201C;"
                                    TextColor="#0F2D4A"
                                    VerticalOptions="Start" />
                                <Label
                                    Grid.Column="1"
                                    FontAttributes="Italic"
                                    FontSize="14"
                                    LineBreakMode="WordWrap"
                                    Text="&quot;Master reading comprehension with ease.&quot;"
                                    TextColor="#6B8CAE"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>

                    </VerticalStackLayout>
                </Border>

            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>