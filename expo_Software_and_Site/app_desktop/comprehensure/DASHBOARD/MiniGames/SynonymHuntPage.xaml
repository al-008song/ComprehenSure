<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="comprehensure.DASHBOARD.MiniGames.SynonymHuntPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F2F6FB"
    Shell.NavBarIsVisible="False">

    <Grid>

 
        <Grid HorizontalOptions="Fill" VerticalOptions="Fill" InputTransparent="True">
            <Ellipse Fill="White"
                     WidthRequest="580" HeightRequest="440"
                     HorizontalOptions="Start" VerticalOptions="Start"
                     Margin="-140,-110,0,0" Opacity="0.75" />
            <Ellipse Fill="#D6EAFF"
                     WidthRequest="460" HeightRequest="380"
                     HorizontalOptions="End" VerticalOptions="End"
                     Margin="0,0,-110,-60" Opacity="0.45" />
        </Grid>

        <ScrollView>
            <VerticalStackLayout Padding="20,20,20,30" Spacing="24">

             
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Grid.Column="0" BackgroundColor="White" Stroke="#CBDCEB" StrokeThickness="1" VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Button Text="← Back" Clicked="OnBackClicked" BackgroundColor="Transparent" TextColor="#0F2D4A" FontAttributes="Bold" FontSize="13" HeightRequest="44" Padding="18,0" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label Text="🔤" FontSize="16" VerticalOptions="Center" />
                            <Label Text="Synonym Hunt" FontSize="17" FontAttributes="Bold" TextColor="#0F2D4A" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label x:Name="ModuleLabel" Text="Module 1 · The Forgotten Library" FontSize="12" TextColor="#6B8CAE" HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <Border Grid.Column="2" BackgroundColor="#0F2D4A" Stroke="Transparent" Padding="16,8" VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="50" />
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="⚡" FontSize="14" VerticalOptions="Center" />
                            <Label x:Name="ScoreLabel" Text="0" FontSize="20" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- ══════════════════════════════════════ -->
                <!-- GAME PANEL                             -->
                <!-- ══════════════════════════════════════ -->
                <Border x:Name="GamePanel" Padding="0" BackgroundColor="White" Stroke="#CBDCEB" StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#0F2D4A" Offset="0,6" Radius="18" Opacity="0.07" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="0">
                        <Border HeightRequest="4">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#4A90D9" Offset="0" />
                                    <GradientStop Color="#0F2D4A" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20,20,0,0" />
                            </Border.StrokeShape>
                        </Border>

                        <VerticalStackLayout Padding="22,20,22,24" Spacing="20">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" x:Name="DifficultyBadge" BackgroundColor="#E8F5E9" Stroke="#A5D6A7" Padding="12,6">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Label x:Name="DifficultyLabel" Text="🟢  Easy" FontSize="11" FontAttributes="Bold" TextColor="#2E7D32" />
                                </Border>
                                <Border Grid.Column="2" BackgroundColor="#F2F6FB" Stroke="#CBDCEB" Padding="12,6">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Label x:Name="QuestionCounterLabel" Text="1 / 3" FontSize="11" FontAttributes="Bold" TextColor="#0F2D4A" />
                                </Border>
                            </Grid>

                            <Border Padding="18,16" BackgroundColor="#F2F6FB" Stroke="#CBDCEB">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                                    <HorizontalStackLayout Grid.Row="0" Spacing="6">
                                        <BoxView BackgroundColor="#4A90D9" WidthRequest="20" HeightRequest="2" VerticalOptions="Center" />
                                        <Label Text="PASSAGE" FontSize="10" FontAttributes="Bold" CharacterSpacing="2.0" TextColor="#6B8CAE" />
                                    </HorizontalStackLayout>
                                    <Label Grid.Row="1" x:Name="StoryLabel" FontSize="14" TextColor="#0F2D4A" LineHeight="1.6" />
                                </Grid>
                            </Border>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" VerticalOptions="Center">
                                <Border Grid.Column="0" HeightRequest="40" WidthRequest="40" BackgroundColor="#0F2D4A">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20" />
                                    </Border.StrokeShape>
                                    <Label x:Name="QuestionNumberLabel" Text="1" FontSize="14" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Grid.Column="1" x:Name="QuestionLabel" FontSize="15" FontAttributes="Bold" TextColor="#0F2D4A" VerticalOptions="Center" />
                            </Grid>

                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                                <!-- A -->
                                <Border Grid.Row="0" Grid.Column="0" x:Name="ChoiceABorder" BackgroundColor="#F2F6FB" Stroke="#CBDCEB" StrokeThickness="1.5">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnChoiceTapped" CommandParameter="0" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="14,16">
                                        <Border Grid.Column="0" x:Name="ChoiceABadge" BackgroundColor="White" Stroke="#CBDCEB" HeightRequest="28" WidthRequest="28">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <Label Text="A" FontSize="11" FontAttributes="Bold" TextColor="#6B8CAE" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <Label Grid.Column="1" x:Name="ChoiceALabel" FontSize="14" FontAttributes="Bold" TextColor="#0F2D4A" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                                <!-- B -->
                                <Border Grid.Row="0" Grid.Column="1" x:Name="ChoiceBBorder" BackgroundColor="#F2F6FB" Stroke="#CBDCEB" StrokeThickness="1.5">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnChoiceTapped" CommandParameter="1" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="14,16">
                                        <Border Grid.Column="0" x:Name="ChoiceBBadge" BackgroundColor="White" Stroke="#CBDCEB" HeightRequest="28" WidthRequest="28">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <Label Text="B" FontSize="11" FontAttributes="Bold" TextColor="#6B8CAE" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <Label Grid.Column="1" x:Name="ChoiceBLabel" FontSize="14" FontAttributes="Bold" TextColor="#0F2D4A" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                                <!-- C -->
                                <Border Grid.Row="1" Grid.Column="0" x:Name="ChoiceCBorder" BackgroundColor="#F2F6FB" Stroke="#CBDCEB" StrokeThickness="1.5">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnChoiceTapped" CommandParameter="2" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="14,16">
                                        <Border Grid.Column="0" x:Name="ChoiceCBadge" BackgroundColor="White" Stroke="#CBDCEB" HeightRequest="28" WidthRequest="28">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <Label Text="C" FontSize="11" FontAttributes="Bold" TextColor="#6B8CAE" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <Label Grid.Column="1" x:Name="ChoiceCLabel" FontSize="14" FontAttributes="Bold" TextColor="#0F2D4A" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                                <!-- D -->
                                <Border Grid.Row="1" Grid.Column="1" x:Name="ChoiceDBorder" BackgroundColor="#F2F6FB" Stroke="#CBDCEB" StrokeThickness="1.5">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnChoiceTapped" CommandParameter="3" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="14,16">
                                        <Border Grid.Column="0" x:Name="ChoiceDBadge" BackgroundColor="White" Stroke="#CBDCEB" HeightRequest="28" WidthRequest="28">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <Label Text="D" FontSize="11" FontAttributes="Bold" TextColor="#6B8CAE" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <Label Grid.Column="1" x:Name="ChoiceDLabel" FontSize="14" FontAttributes="Bold" TextColor="#0F2D4A" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border x:Name="FeedbackBorder" Padding="16,14" BackgroundColor="#E6F5EF" Stroke="#B8E6D4" StrokeThickness="1.5" IsVisible="False">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="12">
                                    <Border BackgroundColor="#1e8a5e" HeightRequest="30" WidthRequest="30">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="15" />
                                        </Border.StrokeShape>
                                        <Label x:Name="FeedbackIcon" Text="✓" FontSize="14" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label x:Name="FeedbackLabel" FontSize="14" FontAttributes="Bold" TextColor="#1e8a5e" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ══════════════════════════════════════ -->
                <!-- PROGRESS BAR                           -->
                <!-- ══════════════════════════════════════ -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14" VerticalOptions="Center">
                    <Border Grid.Column="0" BackgroundColor="#CBDCEB" HeightRequest="10" VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="99" />
                        </Border.StrokeShape>
                        <Grid>
                            <Border x:Name="ProgressFill" HorizontalOptions="Start">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#4A90D9" Offset="0" />
                                        <GradientStop Color="#0F2D4A" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="99" />
                                </Border.StrokeShape>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" BackgroundColor="#0F2D4A">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="50" />
                        </Border.StrokeShape>
                        <Button x:Name="NextButton" Text="Next →" BackgroundColor="Transparent" TextColor="White" FontSize="14" FontAttributes="Bold" HeightRequest="50" Padding="24,0" IsEnabled="False" Clicked="OnNextClicked" />
                    </Border>
                </Grid>

                <!-- ══════════════════════════════════════ -->
                <!-- RESULTS PANEL                          -->
                <!-- ══════════════════════════════════════ -->
                <Border x:Name="ResultsPanel" Padding="26,30" BackgroundColor="White" Stroke="#CBDCEB" IsVisible="False">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                        <Label x:Name="ResultsTrophyLabel" Text="🏆" FontSize="44" HorizontalOptions="Center" />
                        <Label x:Name="ResultsTitleLabel" Text="Outstanding!" FontSize="22" FontAttributes="Bold" TextColor="#0F2D4A" HorizontalOptions="Center" />
                        <Label x:Name="ResultsScoreLabel" Text="0" FontSize="52" FontAttributes="Bold" TextColor="#0F2D4A" HorizontalOptions="Center" />

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <Border Grid.Column="0" BackgroundColor="#F2F6FB" Padding="12,16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <VerticalStackLayout>
                                    <Label x:Name="StatCorrectLabel" Text="0" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center"/>
                                    <Label Text="CORRECT" FontSize="10" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="#F2F6FB" Padding="12,16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <VerticalStackLayout>
                                    <Label x:Name="StatMissedLabel" Text="0" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center"/>
                                    <Label Text="MISSED" FontSize="10" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="2" BackgroundColor="#F2F6FB" Padding="12,16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <VerticalStackLayout>
                                    <Label x:Name="StatAccuracyLabel" Text="0%" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center"/>
                                    <Label Text="ACCURACY" FontSize="10" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <Button Grid.Column="0" Text="Play Again" Clicked="OnRestartClicked" BackgroundColor="White" TextColor="#0F2D4A" HeightRequest="52" />
                            <Button Grid.Column="1" Text="Dashboard" Clicked="OnBackClicked" BackgroundColor="#0F2D4A" TextColor="White" HeightRequest="52" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- CUSTOM MODULE COMPLETE POPUP  (StoryPage style)           -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid x:Name="ModulePopupOverlay"
              IsVisible="False"
              BackgroundColor="#60000000"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">

            <Border HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="400"
                    BackgroundColor="White"
                    Stroke="#CBDCEB"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="36" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#0F2D4A" Offset="0,16" Radius="48" Opacity="0.15" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="0">

                    <!-- Top gradient accent band -->
                    <Border HeightRequest="6" Stroke="Transparent" StrokeThickness="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#0F2D4A" Offset="0" />
                                <GradientStop Color="#4A7FA8" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="36,36,0,0" />
                        </Border.StrokeShape>
                    </Border>

                    <VerticalStackLayout Spacing="20" Padding="36,28,36,32">

                        <!-- Icon chip -->
                        <Border BackgroundColor="#D6EAFF"
                                Stroke="Transparent" StrokeThickness="0"
                                HeightRequest="64" WidthRequest="64"
                                HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="32" />
                            </Border.StrokeShape>
                            <Label x:Name="ModulePopupIcon"
                                   Text="🎉"
                                   FontSize="30"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <!-- Title -->
                        <Label x:Name="ModulePopupTitle"
                               Text="Module Complete!"
                               FontSize="22" FontAttributes="Bold"
                               TextColor="#0F2D4A"
                               HorizontalOptions="Center" />

                        <!-- Body message -->
                        <Label x:Name="ModulePopupMessage"
                               FontSize="14" TextColor="#6B8CAE"
                               HorizontalTextAlignment="Center"
                               LineHeight="1.6"
                               LineBreakMode="WordWrap" />

                        <!-- Divider -->
                        <BoxView HeightRequest="1" BackgroundColor="#D6EAFF" Margin="0,4" />

                        <!-- Action buttons -->
                        <VerticalStackLayout Spacing="12">

                            <Border BackgroundColor="#0F2D4A"
                                    Stroke="Transparent" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="26" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#0F2D4A" Offset="0,6" Radius="16" Opacity="0.22" />
                                </Border.Shadow>
                                <Button x:Name="ModulePopupConfirmButton"
                                        Text="Next Module"
                                        Clicked="OnModulePopupConfirm"
                                        BackgroundColor="Transparent"
                                        TextColor="White"
                                        BorderWidth="0"
                                        FontAttributes="Bold" FontSize="14"
                                        HeightRequest="52" />
                            </Border>

                            <Border BackgroundColor="Transparent"
                                    Stroke="#CBDCEB" StrokeThickness="1.5">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="26" />
                                </Border.StrokeShape>
                                <Button Text="Stay Here"
                                        Clicked="OnModulePopupCancel"
                                        BackgroundColor="Transparent"
                                        TextColor="#0F2D4A"
                                        BorderWidth="0"
                                        FontAttributes="Bold" FontSize="14"
                                        HeightRequest="52" />
                            </Border>

                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
