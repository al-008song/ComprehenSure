                                <Label Text="Finish Module 1 first"
                                       FontSize="12" TextColor="#6B8CAE"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>

                        </Grid>
                    </Border>

