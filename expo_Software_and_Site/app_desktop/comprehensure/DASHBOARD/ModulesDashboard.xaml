                                       TextColor="#0F2D4A" HorizontalOptions="Center" />
                                <Label Text="Finish Module 2 first"
                                       FontSize="12" TextColor="#6B8CAE"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>

                        </Grid>
                    </Border>

